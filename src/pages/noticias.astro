---
// /noticias — página de noticias (contenido desde PostgreSQL + overrides CMS).
import Layout from '@layouts/Layout.astro';
import NoticiasHero from '@components/Noticias/index.astro';
import { getNoticias, getNoticiasHero, type NoticiaFeed } from '@lib/db';
import { getServicioCMS } from '@cms';
import { DEFAULT_NOTICIAS_HERO } from '@cms/sitio/defaults';

const cms = getServicioCMS();
const NOTICIAS_HERO = await cms.efectivo(
  'noticias_hero',
  'principal',
  (await getNoticiasHero()) ?? DEFAULT_NOTICIAS_HERO,
);
const NOTICIAS = (await cms.efectivoLista(
  'noticias',
  (await getNoticias()) as unknown as Record<string, unknown>[],
)) as unknown as NoticiaFeed[];
---

<Layout title="Noticias — Manfred Reyes Villa">
  <NoticiasHero hero={NOTICIAS_HERO} noticias={NOTICIAS} />
</Layout>
