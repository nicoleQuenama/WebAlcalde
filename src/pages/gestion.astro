---
import Layout from '@layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getOptimizedImageSrc } from '@lib/imageOptimize';
import Map from '@components/Map/Map.tsx';
import ProyectosVisor from '@components/Gestion/ProyectosVisor/ProyectosVisor';
import type { VisorCategoria, VisorMedia, VisorObra } from '@components/Gestion/ProyectosVisor/types';
import { ajusteImagen } from '@lib/ajusteImagen';
import { CATEGORIAS_LABELS, CATEGORIAS_ORDEN } from '@constants/proyectoCategorias';
import {
  getCapitulos,
  getGestionHero,
  getEras,
  getProyectos,
  getProyectosTitulo,
  type EraTemario,
  type SeccionTemario,
} from '@lib/db';
import { efectivo, efectivoLista, efectivoOrden } from '@lib/cms/resolve';
import { DEFAULT_GESTION_LAYOUT } from '@lib/cms/defaults';

// ── HERO DE GESTIÓN ──────────────────────────────────────────────────
const GESTION_HERO = efectivo('gestion_hero', 'principal', await getGestionHero());

// ── CAPÍTULOS DE APERTURA ────────────────────────────────────────────
const capitulosApertura = efectivoLista('capitulo', await getCapitulos());

// ── ERAS DE OBRAS ────────────────────────────────────────────────────
const erasCompletas = await getEras();
const erasBase = erasCompletas.map(({ secciones: _s, ...resto }) => resto);
const seccionesBase: (SeccionTemario & { eraId: string })[] = erasCompletas.flatMap((era) =>
  era.secciones.map((s) => ({ ...s, eraId: era.id })),
);
const erasEfectivas = efectivoLista('era', erasBase);
const seccionesEfectivas = efectivoLista('seccion', seccionesBase);
const ERAS: EraTemario[] = erasEfectivas.map((era) => ({
  ...era,
  secciones: seccionesEfectivas.filter((s) => s.eraId === era.id),
})) as EraTemario[];

// ── PROYECTOS (visor por categoría) ──────────────────────────────────
const PROYECTOS = efectivoLista(
  'proyecto',
  (await getProyectos()).map((p, i) => ({ ...p, id: String(i) })),
);
const PROYECTOS_TITULO = efectivo('proyectos_titulo', 'principal', await getProyectosTitulo());

// Obras listas para la isla: imagen pre-optimizada (si la hay), encuadre y la
// mini galería (media). Fotos → optimizadas (thumb 220 + principal 900); videos
// → src mp4 raw (nunca getImage) con poster optimizado (220/900) que cae a la
// imagen de la obra cuando el seed no define uno. Sin w/h conocidos (fotos
// históricas), se usa la URL original sin optimizar.
const obrasVisor: VisorObra[] = await Promise.all(
  PROYECTOS.map(async (p) => {
    const media: VisorMedia[] = await Promise.all(
      (p.media ?? []).map(async (m): Promise<VisorMedia> => {
        if (m.tipo === 'foto') {
          const thumb = m.w && m.h ? await getOptimizedImageSrc(m.src, 220, m.w, m.h) : m.src;
          const src = m.w && m.h ? await getOptimizedImageSrc(m.src, 900, m.w, m.h) : m.src;
          return { tipo: 'foto', src, thumb, alt: m.alt };
        }
        const posterSrc = m.poster ?? p.imagen ?? '';
        const posterW = m.posterW ?? p.w;
        const posterH = m.posterH ?? p.h;
        const thumb =
          posterSrc && posterW && posterH
            ? await getOptimizedImageSrc(posterSrc, 220, posterW, posterH)
            : posterSrc;
        const poster =
          posterSrc && posterW && posterH
            ? await getOptimizedImageSrc(posterSrc, 900, posterW, posterH)
            : thumb;
        return { tipo: 'video', src: m.src, thumb, poster, alt: m.alt };
      }),
    );

    return {
      id: String(p.id ?? ''),
      titulo: p.titulo ?? '',
      descripcion: p.descripcion ?? '',
      categoria: p.categoria ?? '',
      estado: p.estado,
      imagenSrc:
        p.imagen && p.w && p.h ? await getOptimizedImageSrc(p.imagen, 900, p.w, p.h) : undefined,
      objectPosition: ajusteImagen({ encuadre: p.encuadre }).objectPosition,
      media,
    };
  }),
);

// Agrupado por `categoria` en orden conocido (pills primero); categorías
// desconocidas van al final, con label capitalizado.
const capitalizar = (texto: string) =>
  texto.replace(/\p{L}+/gu, (m) => m[0].toUpperCase() + m.slice(1));

const categoriasEncontradas = [...new Set(obrasVisor.map((o) => o.categoria).filter(Boolean))];
const categoriasOrden = [
  ...CATEGORIAS_ORDEN.filter((id) => categoriasEncontradas.includes(id)),
  ...categoriasEncontradas.filter((id) => !CATEGORIAS_ORDEN.includes(id)),
];
const CATEGORIAS_VISOR: VisorCategoria[] = categoriasOrden.map((id) => ({
  id,
  label: CATEGORIAS_LABELS[id] ?? capitalizar(id),
  obras: obrasVisor.filter((o) => o.categoria === id),
}));

// ── ORDEN DE SECCIONES (CMS beta) ────────────────────────────────────
const orden = efectivoOrden('gestion_layout', DEFAULT_GESTION_LAYOUT);
const ordenDe = (clave: string) => {
  const i = orden.indexOf(clave);
  return i === -1 ? 999 : i;
};


---

<Layout title="Gestión — Cocha, la mejor ciudad de Bolivia">
	<main style="display:flex; flex-direction:column;">
		

		<section id="proyectos" class="scroll-mt-20 bg-primary text-white" style={`order:${ordenDe('proyectos')}`}>
			<div class="mx-auto max-w-6xl px-6 py-24 lg:px-8 lg:py-32">
				<header class="max-w-2xl" data-cms-dominio="proyectos_titulo">
					<p class="text-[11px] font-semibold uppercase tracking-[0.34em] text-accent" data-cms-campo="kicker">
						{PROYECTOS_TITULO.kicker}
					</p>
					<h2 class="mt-4 text-[1.9rem] font-bold leading-[1.08] tracking-tight sm:text-4xl lg:text-[2.75rem]" data-cms-campo="titulo">
						{PROYECTOS_TITULO.titulo}
					</h2>
					<p class="mt-5 text-base leading-relaxed text-white/65 lg:text-lg" data-cms-campo="bajada" data-cms-multilinea>{PROYECTOS_TITULO.bajada}</p>
				</header>

				<!-- Visor por categoría (pills/dropdown + prev/next) -->
				<div class="mt-10 lg:mt-14">
					<ProyectosVisor client:visible categorias={CATEGORIAS_VISOR} />
				</div>
			</div>
		</section>
	</main>
</Layout>

<style>
	@media (prefers-reduced-motion: no-preference) {
		[data-hero-gestion] .anim {
			opacity: 0;
			transform: translateY(18px);
			animation: heroGestionIn 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
			animation-delay: var(--d, 0ms);
		}
		@keyframes heroGestionIn {
			to {
				opacity: 1;
				transform: none;
			}
		}
	}
</style>
