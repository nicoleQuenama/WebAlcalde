---
import Layout from '../layouts/Layout.astro';
import HeroGestion from '../components/Gestion/HeroGestion.astro';
import PilaresGestion from '../components/Gestion/PilaresGestion.astro';
import Proyectos from '../components/Gestion/Proyectos.astro';


const BASE = '/Mas%20Recursos/1.%20Recursos%20para%20el%20alcalde/1.1%20Fotograf%C3%ADas%20del%20alcalde/';
const antes = BASE + 'DSC_0790.jpg';
const despues = BASE + 'DSC_0802.jpg';
---

<Layout title="Gestión 2021–2026 - Manfred Reyes Villa">
	<main>
		<HeroGestion />

		<!-- Misión · Biografía · Visión -->
		<PilaresGestion />

		<!-- Proyectos (formato de tarjetas de la página Sobre) -->
		<Proyectos />

		<!-- La ciudad en transformación — cierre de la página -->
		<section class="border-t border-slate-100 bg-white">
			<div class="mx-auto max-w-5xl px-6 py-24 lg:px-8 lg:py-28">
				<header class="max-w-2xl">
					<p class="text-[11px] font-semibold uppercase tracking-[0.34em] text-[#454ca5]">
						Antes y después
					</p>
					<h2 class="mt-4 text-[1.9rem] font-bold leading-[1.08] tracking-tight text-slate-900 sm:text-4xl">
						La ciudad en transformación
					</h2>
					<p class="mt-4 text-base leading-relaxed text-slate-600">
						Desliza para comparar cómo lucían algunos puntos de Cochabamba antes de la intervención.
					</p>
				</header>
			</div>
		</section>
	</main>
</Layout>
