---
/**
 * Home — portada del sitio.
 *
 * Sigue el libro "Cocha, la mejor ciudad de Bolivia":
 *   1. Hero          — título del libro + nombre del alcalde.
 *   2. VideoBiografia — el video, justo después del hero.
 *   3. AntesDespues   — comparador grande "antes / después" (imágenes de referencia).
 *   4. IntroLibro     — introducción al libro digital; se abre ahí mismo.
 *
 * Biografía (texto), misión y visión viven en /sobre, no en el home.
 */
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero/Hero.astro';
import VideoBiografia from '../components/Home/VideoBiografia.astro';
import AntesDespues from '../components/Home/AntesDespues.astro';
import IntroLibro from '../components/Home/IntroLibro.astro';
---

<Layout title="Manfred Reyes Villa — Cocha, la mejor ciudad de Bolivia">
	<Hero eyebrow="Cocha, la mejor ciudad de Bolivia" titulo="Manfred Reyes Villa" />
	<VideoBiografia />
	<AntesDespues />
	<IntroLibro />
</Layout>
