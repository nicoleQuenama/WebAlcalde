---
import { getOptimizedImageSrc, getExactSizeImageSrc, getComparadorImageSrc } from '@lib/imageOptimize';
import Layout from '@layouts/Layout.astro';
import { MEDIA } from '@lib/media';
import { efectivo, efectivoOrden, getTemarioEfectivo } from '@lib/cms/resolve';
import { buildLibroToc } from '@lib/flipBook';
import {
  DEFAULT_HOME_HERO,
  DEFAULT_HOME_ANTES_DESPUES,
  DEFAULT_HOME_BIOGRAFIA,
  DEFAULT_FLIPBOOK_META,
  DEFAULT_HOME_LAYOUT,
} from '@lib/cms/defaults';
import Hero from '@components/global/Hero/Hero.astro';
import BiographyVideo from '@components/Home/BiographyVideo/index.astro';
import AntesDespues from '@components/Home/AntesDespues/AntesDespues.astro';
import LibroIntro from '@components/Home/LibroIntro/LibroIntro.astro';
// Ruta relativa: el alias `@types` choca hoy con ts6137 en todo el repo (bug preexistente).
import type { ParComparador } from '../types/comparador';
import '@styles/sobre.css';

// ── CMS (beta, en memoria) ───────────────────────────────────────────
const heroTexto = efectivo('home_hero', 'principal', DEFAULT_HOME_HERO);
const antesDespuesTexto = efectivo('home_antes_despues', 'principal', DEFAULT_HOME_ANTES_DESPUES);
const biografiaTexto = efectivo('home_biografia', 'principal', DEFAULT_HOME_BIOGRAFIA);
const libro = efectivo('flipbook_meta', 'principal', DEFAULT_FLIPBOOK_META);
const orden = efectivoOrden('home_layout', DEFAULT_HOME_LAYOUT);
const ordenDe = (clave: string) => {
  const i = orden.indexOf(clave);
  return i === -1 ? 999 : i;
};

// Panorámica DJI_0001-Pano.webp = 5570×3481 → alto real a 900px de ancho (fallback si no hay carrusel).
const fondoSrc = await getExactSizeImageSrc(MEDIA.hero.home.panoramica, 900, 562, 72);

// ── VIDEO BIOGRAFÍA ───────────────────────────────────────────────────
const posterBiografia = await getExactSizeImageSrc(MEDIA.biografia.poster, 2549, 3568);
const videoBiografia = MEDIA.biografia.video;

// ── ANTES / DESPUÉS ───────────────────────────────────────────────────
const pares: ParComparador[] = await Promise.all(
  MEDIA.antesDespues.map(async (p) => ({
    titulo: p.titulo,
    antes: await getComparadorImageSrc(p.antes),
    despues: await getComparadorImageSrc(p.despues, p.despuesHeight),
    afterFit: p.afterFit,
    afterPosition: p.afterPosition,
    afterScale: p.afterScale,
  })),
);

// ── LIBRO DIGITAL ─────────────────────────────────────────────────────
// capitulo/era/seccion pasan por el store del CMS (beta): lo editado desde
// /admin/[secret]?pagina=gestion se refleja acá también, son el mismo dominio.
const { capitulos, eras } = await getTemarioEfectivo();

// Fotos y videos que Book.tsx reparte entre las páginas (optimizado vía @lib/imageOptimize)
const fotos = await Promise.all(
  MEDIA.libro.fotos.map(async (f) => ({
    ...f,
    src: await getOptimizedImageSrc(f.src, 700, f.w, f.h, 72),
  })),
);
const videos = MEDIA.libro.videos;

// Índice del libro (mismo orden de páginas que Book.tsx).
const toc = buildLibroToc(capitulos, eras);
---

<Layout title="Manfred Reyes Villa — Cocha, la mejor ciudad de Bolivia">
    <div style="display:flex; flex-direction:column;">
    <!-- ═══ HERO (mismo diseño que /sobre, con el texto del home) ═══ -->
    <Hero
        fondoSrc={fondoSrc}
        fotosFondo={MEDIA.hero.home.fondo}
        eyebrow={heroTexto.eyebrow}
        titulo={heroTexto.titulo}
        style={`order:${ordenDe('hero')}`}
        dominio="home_hero"
    />

    <!-- ═══ BIOGRAFÍA ═══ -->
    <BiographyVideo
        videoBiografia={videoBiografia}
        posterBiografia={posterBiografia}
        eyebrow={biografiaTexto.eyebrow}
        titulo={biografiaTexto.titulo}
        parrafo={biografiaTexto.parrafo}
        cta1Label={biografiaTexto.cta1Label}
        cta1Href={biografiaTexto.cta1Href}
        cta2Label={biografiaTexto.cta2Label}
        cta2Href={biografiaTexto.cta2Href}
        style={`order:${ordenDe('biografia')}`}
        dominio="home_biografia"
    />

    <!-- ═══ ANTES / DESPUÉS ═══ -->
    <AntesDespues
        kicker={antesDespuesTexto.kicker}
        titulo={antesDespuesTexto.titulo}
        parrafo={antesDespuesTexto.parrafo}
        pares={pares}
        style={`order:${ordenDe('antes_despues')}`}
        dominio="home_antes_despues"
    />

    <!-- ═══ INTRODUCCIÓN AL LIBRO DIGITAL ═══ -->
    <LibroIntro
        libro={libro}
        capitulos={capitulos}
        eras={eras}
        fotos={fotos}
        videos={videos}
        toc={toc}
        style={`order:${ordenDe('libro')}`}
        dominio="flipbook_meta"
    />

    <section>
      <section>
        <script src="https://elfsightcdn.com/platform.js" async></script>
        <div class="elfsight-app-5ca2e603-6ff5-4c5f-bf69-4689838a733c" data-elfsight-app-lazy></div>
      </section>
    </section>
    </div>
</Layout>
