---
/**
 * Home — portada del sitio.
 *
 * Sigue el libro "Cocha, la mejor ciudad de Bolivia":
 *   1. Hero          — título del libro + nombre del alcalde (carrusel de fotos).
 *   2. VideoBiografia — el video, justo después del hero.
 *   3. AntesDespues   — comparador grande "antes / después" (imágenes de referencia).
 *   4. IntroLibro     — introducción al libro digital; se abre ahí mismo.
 *
 * Todo el contenido (capítulos, eras, hitos, proyectos…) sale de la base SQLite
 * (src/lib/db.ts); las fotos/videos resuelven Supabase (src/lib/media.ts).
 * Las secciones viven AQUÍ dentro: ya no hay componentes .astro intermedios.
 */
import { getImage } from 'astro:assets';
import Layout from '@layouts/Layout.astro';
import { getCapitulos, getEras } from '@lib/db';
import { MEDIA } from '@lib/media';
import Hero from '@components/global/Hero/Hero.astro';
import HeroCards from '@components/global/Hero/HeroCard.tsx';
import type { TarjetaImagen } from '@components/global/Hero/HeroCard.tsx';
import ComparadorAntesDespues from '@components/Home/ComparatingProjects/ProjectSlide.tsx';
import type { ParComparador } from '@components/Home/ComparatingProjects/ProjectSlide.tsx';
import FlipBook from '@components/FlipBook/FlipBook';
import Book from '@components/Home/BookSection/Book3D';
import BiographyVideo from '@components/Home/BiographyVideo/index.astro';
import '@styles/sobre.css';

// ── HERO ──────────────────────────────────────────────────────────────
// Optimización en build: el carrusel se sirve a ~900px webp; el fondo, chico
// y borroso. El `height` se calcula con las dimensiones reales (w/h) para NO
// deformar con `inferSize` (Astro lee mal algunos remotos y recorta la foto).
const imgs: TarjetaImagen[] = await Promise.all(
  MEDIA.hero.carrusel.map(async (img) => ({
    ...img,
    src: (
      await getImage({
        src: img.src,
        width: 900,
        ...(img.w && img.h ? { height: Math.max(1, Math.round((900 * img.h) / img.w)) } : {}),
        fit: 'cover',
        format: 'webp',
      })
    ).src,
  })),
);
// Panorámica DJI_0001-Pano.webp = 5570×3481 → alto real a 900px de ancho.
const fondo = await getImage({
  src: MEDIA.hero.panoramica,
  width: 900,
  height: 562,
  quality: 30,
  format: 'webp',
});

// ── VIDEO BIOGRAFÍA ───────────────────────────────────────────────────
const posterBiografia = (
  await getImage({ src: MEDIA.biografia.poster, width: 2549, height: 3568, format: 'webp' })
).src;
const videoBiografia = MEDIA.biografia.video;

// ── ANTES / DESPUÉS ───────────────────────────────────────────────────
const opt = async (src: string, height?: number) =>
  (
    await getImage({
      src,
      inferSize: !height,
      width: 1200,
      ...(height ? { height } : {}),
      format: 'webp',
    })
  ).src;

const pares: ParComparador[] = await Promise.all(
  MEDIA.antesDespues.map(async (p) => ({
    titulo: p.titulo,
    antes: await opt(p.antes),
    despues: await opt(p.despues, p.despuesHeight),
    afterFit: p.afterFit,
    afterPosition: p.afterPosition,
    afterScale: p.afterScale,
  })),
);

// ── LIBRO DIGITAL ─────────────────────────────────────────────────────
const [PRESENTACION, CRECIMIENTO, NUEVA_COCHABAMBA] = getCapitulos();
const ERAS = getEras();

// Fotos y videos que Book.tsx reparte entre las páginas (todo en Supabase).
// Las fotos se optimizan en build (~1000px webp) CONSERVANDO su proporción real.
const fotos = await Promise.all(
  MEDIA.libro.fotos.map(async (f) => ({
    ...f,
    src: (
      await getImage({
        src: f.src,
        width: 1000,
        ...(f.w && f.h ? { height: Math.max(1, Math.round((1000 * f.h) / f.w)) } : {}),
        fit: 'cover',
        format: 'webp',
      })
    ).src,
  })),
);
const videos = MEDIA.libro.videos;

// Índice del libro (mismo orden de páginas que Book.tsx).
let p = 1;
const aperturaItems = [
  { label: 'Portada', page: 0 },
  { label: PRESENTACION.eyebrow, page: p++ },
  { label: CRECIMIENTO.titulo, page: p++ },
  { label: NUEVA_COCHABAMBA.titulo, page: p++ },
];
const gruposEras = ERAS.map((era) => {
  const items = [{ label: era.titulo, page: p++ }];
  for (const sec of era.secciones) items.push({ label: sec.titulo, page: p++ });
  return { title: era.eyebrow, items };
});
const toc = [
  { title: 'Apertura', items: aperturaItems },
  ...gruposEras,
  { title: 'Cierre', items: [{ label: 'Contraportada', page: p }] },
];
---

<Layout title="Manfred Reyes Villa — Cocha, la mejor ciudad de Bolivia">
    <!-- ═══ HERO (mismo diseño que /sobre, con el texto del home) ═══ -->
    <Hero
        fondoSrc={fondo.src}
        eyebrow="Cocha, la mejor ciudad de Bolivia"
        titulo="Manfred Reyes Villa"
    >
        <HeroCards client:load imagenes={imgs} autoplayMs={4500} slot="media" />
    </Hero>

    <!-- ═══ BIOGRAFÍA ═══ -->
    <BiographyVideo videoBiografia={videoBiografia} posterBiografia={posterBiografia} />

    <!-- ═══ ANTES / DESPUÉS ═══ -->
    <section class="bg-white">
        <div class="mx-auto max-w-5xl px-6 py-20 lg:px-8 lg:py-28">
            <header class="max-w-2xl">
                <p class="text-[11px] font-semibold uppercase tracking-[0.34em] text-primary">
                    Antes y después
                </p>
                <h2 class="mt-4 text-[1.9rem] font-bold leading-[1.08] tracking-tight text-slate-900 sm:text-4xl">
                    De una ciudad de ayer a una que mira al futuro
                </h2>
                <p class="mt-4 max-w-xl text-base leading-relaxed text-slate-600">
                    Desliza el tirador para comparar cada punto; usa las flechas para pasar al siguiente.
                </p>
            </header>

            <div class="mt-12">
                <ComparadorAntesDespues client:visible pares={pares} />
            </div>
        </div>
    </section>

    <!-- ═══ INTRODUCCIÓN AL LIBRO DIGITAL ═══ -->
    <section class="bg-primary text-white">
        <div class="mx-auto flex max-w-5xl flex-col gap-8 px-6 py-16 lg:px-8 lg:py-20">
            <header class="max-w-2xl">
                <p class="text-[11px] font-semibold uppercase tracking-[0.34em] text-accent">
                    El libro digital
                </p>
                <p class="mt-4 text-base leading-relaxed text-white/75">
                    Un recorrido en imágenes por las obras que transformaron Cochabamba, de los años 90 a
                    la gestión 2021–2026. Ábrelo y hojéalo página por página, con fotos y videos.
                </p>
            </header>

            <FlipBook
                client:idle
                width={350}
                height={560}
                title="Cocha, la mejor ciudad de Bolivia"
                subtitle="Las obras, los servicios y la gestión de la ciudad, contadas como un álbum."
                ctaLabel="Abrir libro"
                coverImage="/cocha.jpg"
                toc={toc}
            >
                <Book coverImage="/cocha.jpg" capitulos={[PRESENTACION, CRECIMIENTO, NUEVA_COCHABAMBA]} eras={ERAS} fotos={fotos} videos={videos} />
            </FlipBook>
        </div>
    </section>
</Layout>