---
/**
 * Home — portada del sitio.
 *
 * Sigue el libro "Cocha, la mejor ciudad de Bolivia":
 *   1. Hero          — título del libro + nombre del alcalde (carrusel de fotos).
 *   2. VideoBiografia — el video, justo después del hero.
 *   3. AntesDespues   — comparador grande "antes / después" (imágenes de referencia).
 *   4. IntroLibro     — introducción al libro digital; se abre ahí mismo.
 *
 * Todo el contenido (capítulos, eras, hitos, proyectos…) sale de la base SQLite
 * (src/lib/db.ts); las fotos/videos resuelven Supabase (src/lib/media.ts).
 * Las secciones viven AQUÍ dentro: ya no hay componentes .astro intermedios.
 */
import { getImage } from 'astro:assets';
import Layout from '@layouts/Layout.astro';
import { getCapitulos, getEras } from '@lib/db';
import { MEDIA } from '@lib/media';
import HeroCards from '@components/Hero/HeroCard.tsx';
import type { TarjetaImagen } from '@components/Hero/HeroCard.tsx';
import ComparadorAntesDespues from '@components/Home/ComparatingProjects.component.tsx';
import type { ParComparador } from '@components/Home/ComparatingProjects.component.tsx';
import FlipBook from '@components/FlipBook/FlipBook';
import Book from '@components/Book/Book';
import '../styles/sobre.css';

// ── HERO ──────────────────────────────────────────────────────────────
// Optimización en build: el carrusel se sirve a ~900px webp; el fondo, chico
// y borroso. El `height` se calcula con las dimensiones reales (w/h) para NO
// deformar con `inferSize` (Astro lee mal algunos remotos y recorta la foto).
const imgs: TarjetaImagen[] = await Promise.all(
  MEDIA.hero.carrusel.map(async (img) => ({
    ...img,
    src: (
      await getImage({
        src: img.src,
        width: 900,
        ...(img.w && img.h ? { height: Math.max(1, Math.round((900 * img.h) / img.w)) } : {}),
        fit: 'cover',
        format: 'webp',
      })
    ).src,
  })),
);
// Panorámica DJI_0001-Pano.webp = 5570×3481 → alto real a 900px de ancho.
const fondo = await getImage({
  src: MEDIA.hero.panoramica,
  width: 900,
  height: 562,
  quality: 30,
  format: 'webp',
});

// ── VIDEO BIOGRAFÍA ───────────────────────────────────────────────────
const posterBiografia = (
  await getImage({ src: MEDIA.biografia.poster, width: 2549, height: 3568, format: 'webp' })
).src;
const videoBiografia = MEDIA.biografia.video;

// ── ANTES / DESPUÉS ───────────────────────────────────────────────────
const opt = async (src: string, height?: number) =>
  (
    await getImage({
      src,
      inferSize: !height,
      width: 1200,
      ...(height ? { height } : {}),
      format: 'webp',
    })
  ).src;

const pares: ParComparador[] = await Promise.all(
  MEDIA.antesDespues.map(async (p) => ({
    titulo: p.titulo,
    antes: await opt(p.antes),
    despues: await opt(p.despues, p.despuesHeight),
    afterFit: p.afterFit,
    afterPosition: p.afterPosition,
    afterScale: p.afterScale,
  })),
);

// ── LIBRO DIGITAL ─────────────────────────────────────────────────────
const [PRESENTACION, CRECIMIENTO, NUEVA_COCHABAMBA] = getCapitulos();
const ERAS = getEras();

// Fotos y videos que Book.tsx reparte entre las páginas (todo en Supabase).
// Las fotos se optimizan en build (~1000px webp) CONSERVANDO su proporción real.
const fotos = await Promise.all(
  MEDIA.libro.fotos.map(async (f) => ({
    ...f,
    src: (
      await getImage({
        src: f.src,
        width: 1000,
        ...(f.w && f.h ? { height: Math.max(1, Math.round((1000 * f.h) / f.w)) } : {}),
        fit: 'cover',
        format: 'webp',
      })
    ).src,
  })),
);
const videos = MEDIA.libro.videos;

// Índice del libro (mismo orden de páginas que Book.tsx).
let p = 1;
const aperturaItems = [
  { label: 'Portada', page: 0 },
  { label: PRESENTACION.eyebrow, page: p++ },
  { label: CRECIMIENTO.titulo, page: p++ },
  { label: NUEVA_COCHABAMBA.titulo, page: p++ },
];
const gruposEras = ERAS.map((era) => {
  const items = [{ label: era.titulo, page: p++ }];
  for (const sec of era.secciones) items.push({ label: sec.titulo, page: p++ });
  return { title: era.eyebrow, items };
});
const toc = [
  { title: 'Apertura', items: aperturaItems },
  ...gruposEras,
  { title: 'Cierre', items: [{ label: 'Contraportada', page: p }] },
];
---

<Layout title="Manfred Reyes Villa — Cocha, la mejor ciudad de Bolivia">
    <!-- ═══ HERO (mismo diseño que /sobre, con el texto del home) ═══ -->
    <section class="relative flex min-h-[100svh] w-full items-center justify-center bg-primary px-0 pb-16 pt-24 lg:pt-28">
        <!-- Fondo: panorámica desenfocada + velo del color de marca (sin sombras) -->
        <div class="absolute inset-0 z-0 overflow-hidden">
            <div
                class="absolute inset-0 scale-110 bg-cover bg-center opacity-40 blur-xl"
                style={`background-image: url('${fondo.src}');`}
            ></div>
            <div class="absolute inset-0 bg-primary/80 mix-blend-multiply"></div>
            <div class="absolute inset-0 bg-gradient-to-b from-primary/40 to-primary"></div>
        </div>

        <!-- Contenido -->
        <div class="relative z-10 mx-auto grid w-full max-w-7xl grid-cols-1 items-center gap-16 px-6 lg:grid-cols-2 lg:px-12">
            <!-- Columna izquierda: carrusel de imágenes grandes -->
            <div class="flex w-full justify-center">
                <HeroCards client:load imagenes={imgs} autoplayMs={4500} />
            </div>

            <!-- Columna derecha: textos -->
            <div class="flex flex-col items-center space-y-6 text-center lg:items-start lg:text-left">
                <!-- Máquina de escribir 1 -->
                <div class="relative w-max max-w-full">
                    <p class="invisible whitespace-nowrap pr-2 font-roboto-serif text-[11px] uppercase tracking-[0.14em] opacity-0 sm:text-sm sm:tracking-[0.2em]">
                        Cocha, la mejor ciudad de Bolivia
                    </p>
                    <p class="typewriter-1 absolute left-0 top-0 h-full overflow-hidden whitespace-nowrap pr-2 font-roboto-serif text-[11px] uppercase tracking-[0.14em] text-accent sm:text-sm sm:tracking-[0.2em]">
                        Cocha, la mejor ciudad de Bolivia
                    </p>
                </div>

                <!-- Máquina de escribir 2 -->
                <div class="relative w-max max-w-full">
                    <h1 class="invisible whitespace-nowrap py-1 pr-4 font-roboto-serif text-4xl leading-[1.1] text-white opacity-0 sm:text-5xl lg:text-7xl">
                        Manfred Reyes Villa
                    </h1>
                    <h1 class="typewriter-2 absolute left-0 top-0 h-full overflow-hidden whitespace-nowrap py-1 font-serif text-3xl leading-[1.1] text-white sm:text-4xl lg:text-6xl">
                        Manfred Reyes Villa
                    </h1>
                </div>
            </div>
        </div>
    </section>

    <!-- ═══ VIDEO DE BIOGRAFÍA ═══ -->
    <section class="bg-white">
        <div class="mx-auto max-w-4xl px-6 py-16 lg:px-8 lg:py-20">
            <p class="text-[11px] font-semibold uppercase tracking-[0.34em] text-primary">
                Manfred Reyes Villa
            </p>
            <h2 class="mt-4 text-[1.9rem] font-bold leading-[1.08] tracking-tight text-slate-900 sm:text-4xl">
                La ciudad, contada en un video
            </h2>

            <figure class="mt-8 overflow-hidden rounded-2xl border border-slate-200">
                <video
                    class="aspect-video bg-slate-900 object-cover object-[50%_7%]"
                    src={videoBiografia}
                    poster={posterBiografia}
                    controls
                    preload="metadata"
                    playsinline
                ></video>
                <figcaption class="bg-slate-50 px-4 py-2 text-xs font-medium italic text-slate-400">
                    Manfred Reyes Villa — su historia y su vínculo con Cochabamba.
                </figcaption>
            </figure>

            <a
                href="/sobre"
                class="mt-8 inline-flex items-center gap-2 rounded-full bg-primary px-6 py-2.5 text-xs font-bold uppercase tracking-[0.14em] text-white transition-transform hover:-translate-y-0.5"
            >
                Conocer al alcalde
                <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </a>
        </div>
    </section>

    <!-- ═══ ANTES / DESPUÉS ═══ -->
    <section class="bg-white">
        <div class="mx-auto max-w-5xl px-6 py-20 lg:px-8 lg:py-28">
            <header class="max-w-2xl">
                <p class="text-[11px] font-semibold uppercase tracking-[0.34em] text-primary">
                    Antes y después
                </p>
                <h2 class="mt-4 text-[1.9rem] font-bold leading-[1.08] tracking-tight text-slate-900 sm:text-4xl">
                    De una ciudad de ayer a una que mira al futuro
                </h2>
                <p class="mt-4 max-w-xl text-base leading-relaxed text-slate-600">
                    Desliza el tirador para comparar cada punto; usa las flechas para pasar al siguiente.
                </p>
            </header>

            <div class="mt-12">
                <ComparadorAntesDespues client:visible pares={pares} />
            </div>
        </div>
    </section>

    <!-- ═══ INTRODUCCIÓN AL LIBRO DIGITAL ═══ -->
    <section class="bg-primary text-white">
        <div class="mx-auto flex max-w-5xl flex-col gap-8 px-6 py-16 lg:px-8 lg:py-20">
            <header class="max-w-2xl">
                <p class="text-[11px] font-semibold uppercase tracking-[0.34em] text-accent">
                    El libro digital
                </p>
                <p class="mt-4 text-base leading-relaxed text-white/75">
                    Un recorrido en imágenes por las obras que transformaron Cochabamba, de los años 90 a
                    la gestión 2021–2026. Ábrelo y hojéalo página por página, con fotos y videos.
                </p>
            </header>

            <FlipBook
                client:idle
                width={350}
                height={560}
                title="Cocha, la mejor ciudad de Bolivia"
                subtitle="Las obras, los servicios y la gestión de la ciudad, contadas como un álbum."
                ctaLabel="Abrir libro"
                coverImage="/cocha.jpg"
                toc={toc}
            >
                <Book coverImage="/cocha.jpg" capitulos={[PRESENTACION, CRECIMIENTO, NUEVA_COCHABAMBA]} eras={ERAS} fotos={fotos} videos={videos} />
            </FlipBook>
        </div>
    </section>
</Layout>