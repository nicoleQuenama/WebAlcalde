---
import AdminLayout from '@layouts/AdminLayout.astro';
import { listarMensajes } from '@lib/db';
import { obtenerTokenDeRequest, usuarioValido } from '@lib/auth';

const secreto = import.meta.env.ADMIN_SECRET_PATH;
if (!secreto || Astro.params.secret !== secreto) {
  return new Response(null, { status: 404 });
}

// Acceso restringido también a usuarios autenticados.
if (!(await usuarioValido(obtenerTokenDeRequest(Astro.request)))) {
  return Astro.redirect('/admin/login');
}

const mensajes = await listarMensajes();

const ETIQUETAS: Record<string, string> = {
  sugerencia: 'Sugerencia',
  felicitacion: 'Felicitación',
};

function formatearFecha(iso: string): string {
  return new Date(iso).toLocaleString('es-BO', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  });
}
---

<AdminLayout title="Buzón Ciudadano — Panel de administración">
    <main class="relative flex min-h-svh w-full overflow-hidden bg-primary px-6 py-12">
        <div class="absolute inset-0 bg-gradient-to-br from-hero-from via-hero-via to-hero-to" aria-hidden="true"></div>
        <div class="absolute inset-0 bg-primary/40 mix-blend-multiply" aria-hidden="true"></div>

        <div class="relative z-10 mx-auto w-full max-w-4xl">
            <header class="mb-8 flex flex-wrap items-center justify-between gap-4">
                <div>
                    <p class="text-[11px] font-semibold uppercase tracking-[0.34em] text-accent">
                        Buzón Ciudadano
                    </p>
                    <h1 class="mt-3 text-2xl font-bold tracking-tight text-white">
                        Mensajes recibidos
                    </h1>
                </div>
                <a
                    href="/admin/login"
                    class="inline-flex items-center gap-2 rounded-xl border border-accent/40 px-5 py-2.5 text-xs font-bold uppercase tracking-[0.14em] text-accent transition-colors hover:border-accent hover:text-white"
                >
                    ← Volver al panel
                </a>
            </header>

            {
                mensajes.length === 0 ? (
                    <div class="rounded-3xl bg-white p-10 text-center shadow-2xl shadow-black/30">
                        <h2 class="text-lg font-bold text-slate-900">Todavía no hay mensajes</h2>
                        <p class="mt-2 text-sm leading-relaxed text-slate-500">
                            Cuando alguien envíe una sugerencia o felicitación desde
                            /buzon, aparecerá acá en orden cronológico.
                        </p>
                    </div>
                ) : (
                    <ul class="flex flex-col gap-4">
                        {mensajes.map((m) => (
                            <li class="rounded-3xl bg-white p-6 shadow-2xl shadow-black/30 sm:p-8">
                                <div class="flex flex-wrap items-center gap-3">
                                    <h2 class="text-base font-bold text-slate-900">{m.nombre}</h2>
                                    <span
                                        class:list={[
                                            'rounded-full px-3 py-1 text-[11px] font-semibold uppercase tracking-wide',
                                            m.tipo === 'felicitacion'
                                                ? 'bg-emerald-100 text-emerald-700'
                                                : 'bg-primary/10 text-primary',
                                        ]}
                                    >
                                        {ETIQUETAS[m.tipo] ?? m.tipo}
                                    </span>
                                    <span class="ml-auto text-xs text-slate-400">
                                        {formatearFecha(m.creadoEn)}
                                    </span>
                                </div>
                                <p class="mt-4 whitespace-pre-wrap text-sm leading-relaxed text-slate-600">
                                    {m.mensaje}
                                </p>
                            </li>
                        ))}
                    </ul>
                )
            }
        </div>
    </main>
</AdminLayout>