---
import '@styles/admin-cms.css';
import { paginaPorId, PAGINAS } from '../../admin/campos';
import { calcularDatosPagina } from '@lib/cms/datosPagina';

const secreto = import.meta.env.ADMIN_SECRET_PATH;
if (!secreto || Astro.params.secret !== secreto) {
  return new Response(null, { status: 404 });
}

const paginaId = Astro.url.searchParams.get('pagina') || 'inicio';
const datos = calcularDatosPagina(paginaId) ?? calcularDatosPagina('inicio')!;

const initData = {
  ...datos,
  secreto,
  // Rutas de todas las páginas editables: así el editor sabe qué página es
  // cuál cuando el admin navega DENTRO del iframe con la navegación real
  // del sitio (en vez de una barra de páginas aparte, redundante).
  paginas: PAGINAS.map((p) => ({ pagina: p.pagina, titulo: p.titulo, ruta: p.ruta })),
};
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Editor — {datos.pagina.titulo}</title>
  </head>
  <body>
    <div id="cms-app">
      <div class="cms-topbar">
        <span class="cms-topbar__marca">Editor Cocha</span>
        <div class="cms-topbar__derecha">
          <span id="cms-estado" class="cms-estado">Todo guardado</span>
          <a class="cms-preview" id="cms-ver-pagina" href={datos.pagina.ruta} target="_blank" rel="noreferrer">
            Ver página ↗
          </a>
          <button id="cms-guardar" class="cms-btn" type="button">Guardar cambios</button>
        </div>
      </div>
      <div id="cms-shell">
        <div class="cms-device-bar">
          <button class="cms-device-btn activo" type="button" data-device="full">Escritorio</button>
          <button class="cms-device-btn" type="button" data-device="768">Tablet</button>
          <button class="cms-device-btn" type="button" data-device="390">Celular</button>
          <button id="cms-refrescar" class="cms-device-btn cms-device-btn--refrescar" type="button" title="Refrescar la vista previa">
            ↻
          </button>
        </div>
        <div class="cms-iframe-wrap">
          <iframe id="cms-iframe" src={datos.pagina.ruta} title="Vista previa"></iframe>
        </div>
      </div>
    </div>

    <!-- ═══ Modal de edición: aparece al hacer clic en algo no editable inline (imagen, selector, obras) o al elegir reordenar/eliminar. ═══ -->
    <div id="cms-modal-overlay" hidden>
      <div id="cms-modal" role="dialog" aria-modal="true"></div>
    </div>

    <script
      type="application/json"
      id="cms-init"
      set:html={JSON.stringify(initData).replace(/</g, '\\u003c')}
    />
    <script>
      import { montarEditor } from '../../admin/editorApp';
      const el = document.getElementById('cms-init');
      const init = JSON.parse(el?.textContent || '{}');
      montarEditor(init);
    </script>
  </body>
</html>
