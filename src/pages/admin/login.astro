---
import AdminLayout from '@layouts/AdminLayout.astro';
import { MEDIA } from '@lib/media';
import { obtenerTokenDeRequest, usuarioValido } from '@lib/auth';

const sesionActiva = (await usuarioValido(obtenerTokenDeRequest(Astro.request))) !== null;
if (sesionActiva) {
    return Astro.redirect('/admin');
}

const query = Astro.url.searchParams;
const errorMsg: Record<string, string> = {
    vacio: 'Completa usuario y contraseña.',
    credenciales: 'Usuario o contraseña incorrectos.',
    bloqueado: 'Demasiados intentos fallidos. Espera unos minutos e intenta de nuevo.',
    noconfigurado: 'La autenticación aún no está configurada. Define ADMIN_USER y ADMIN_PASSWORD.',
};
const mensajeError = errorMsg[query.get('error') ?? ''] ?? null;
---

<AdminLayout title="Iniciar sesión — Administración">
    <main class="relative flex min-h-svh w-full items-center justify-center overflow-hidden px-4 py-12 sm:px-6">
        
        <!-- FONDO ORIGINAL MANTENIDO -->
        <div class="absolute inset-0 bg-gradient-to-br from-hero-from via-hero-via to-hero-to" aria-hidden="true"></div>
        <div class="absolute inset-0 bg-primary/30 mix-blend-multiply" aria-hidden="true"></div>
        <div class="absolute -top-32 -right-32 h-96 w-96 rounded-full bg-accent/10 blur-3xl" aria-hidden="true"></div>
        <div class="absolute -bottom-40 -left-40 h-[500px] w-[500px] rounded-full bg-primary-light/15 blur-3xl" aria-hidden="true"></div>

        <!-- TARJETA CONTENEDORA DIVIDIDA -->
        <!-- Mantenemos el borde redondeado y la sombra para que flote sobre el fondo -->
        <div class="relative z-10 flex w-full max-w-4xl flex-col overflow-hidden rounded-3xl bg-white shadow-2xl shadow-black/50 animate-fadeInUp motion-reduce:animate-none md:flex-row">
            
            <!-- PANEL IZQUIERDO (Visual - Mitad de la card) -->
            <div class="relative flex w-full flex-col items-center justify-center bg-gradient-to-br from-primary to-primary-light p-10 text-white md:w-1/2">
                
                <!-- Capa oscura semitransparente para dar profundidad al color de fondo -->
                <div class="absolute inset-0 bg-black/10 mix-blend-multiply" aria-hidden="true"></div>
                
                <!-- Contenedor interno: flex-col y justify-between empujan el logo arriba y los puntos abajo -->
                <div class="relative z-10 flex h-full min-h-[350px] w-full flex-col items-center justify-between text-center">
                    
                    <!-- 1. SECCIÓN DEL LOGO -->
                    <!-- Aquí puedes cambiar el tamaño modificando h-14 y w-14 -->
                    <div class="pt-4 animate-fadeInUp opacity-0 motion-reduce:animate-none motion-reduce:opacity-100 [animation-delay:0.1s]">
                        <img src={MEDIA.logo} alt="Logo" class="h-14 w-14 object-contain brightness-0 invert opacity-90 transition-transform duration-500 hover:scale-110" />
                    </div>
                    
                    <!-- Contenedor central.-->
                    <div class="my-auto py-8 animate-fadeInUp opacity-0 motion-reduce:animate-none motion-reduce:opacity-100 [animation-delay:0.25s]">
                        <h2 class="text-xl font-light tracking-wide sm:text-2xl">
                            LOGIN<br/> MRV
                        </h2>
                    </div>
                </div>
            </div>

            <!-- lado derecho-->
            <div class="flex w-full flex-col justify-center bg-white p-8 sm:p-12 md:w-1/2">
                <div class="mx-auto w-full max-w-sm">
                    
                    <!-- Título -->
                    <div class="mb-10 text-slate-900 animate-fadeInUp opacity-0 motion-reduce:animate-none motion-reduce:opacity-100">
                        <h1 class="text-2xl font-light">
                            Iniciar sesión
                        </h1>
                    </div>

                    <!-- Mensaje de Error -->
                    {mensajeError && (
                        <div role="alert" class="mb-6 flex items-start gap-3 rounded-lg border border-red-200 bg-red-50 px-4 py-3 animate-fadeInUp motion-reduce:animate-none">
                            <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
                            </svg>
                            <p class="text-sm font-medium text-red-700">{mensajeError}</p>
                        </div>
                    )}

                    <!-- Formulario -->
                    <form method="post" action="/api/auth/login" class="space-y-8">
                        <!-- Input Usuario -->
                        <div class="group relative animate-fadeInUp opacity-0 motion-reduce:animate-none motion-reduce:opacity-100 [animation-delay:0.15s]">
                            <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center text-slate-400 transition-colors duration-300 group-focus-within:text-primary">
                                <svg class="h-[18px] w-[18px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
                                </svg>
                            </span>
                            <input
                                id="usuario"
                                name="usuario"
                                type="text"
                                required
                                autocomplete="username"
                                autocapitalize="none"
                                spellcheck="false"
                                placeholder=" "
                                class="peer w-full border-b-2 border-slate-200 bg-transparent pl-10 pr-4 pt-5 pb-2 text-sm text-text-primary transition-colors duration-300 placeholder:text-transparent focus:border-primary/30 focus:outline-none autofill:text-text-primary"
                            />
                            <label
                                for="usuario"
                                class="pointer-events-none absolute left-10 top-1/2 -translate-y-1/2 text-sm text-text-muted transition-all duration-300 ease-out peer-focus:top-1.5 peer-focus:translate-y-0 peer-focus:text-[11px] peer-focus:font-semibold peer-focus:tracking-wide peer-focus:text-primary peer-not-placeholder-shown:top-1.5 peer-not-placeholder-shown:translate-y-0 peer-not-placeholder-shown:text-[11px] peer-not-placeholder-shown:font-semibold peer-not-placeholder-shown:text-slate-600"
                            >
                                Usuario
                            </label>
                            <!-- Línea animada al enfocar -->
                            <span class="pointer-events-none absolute bottom-0 left-0 h-[2px] w-full origin-left scale-x-0 rounded-full bg-gradient-to-r from-primary via-primary-light to-accent transition-transform duration-300 ease-out group-focus-within:scale-x-100" aria-hidden="true"></span>
                        </div>

                        <!-- Input Contraseña -->
                        <div class="group relative animate-fadeInUp opacity-0 motion-reduce:animate-none motion-reduce:opacity-100 [animation-delay:0.25s]">
                            <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center text-slate-400 transition-colors duration-300 group-focus-within:text-primary">
                                <svg class="h-[18px] w-[18px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
                                </svg>
                            </span>
                            <input
                                id="contraseña"
                                name="contraseña"
                                type="password"
                                required
                                autocomplete="current-password"
                                minlength={8}
                                placeholder=" "
                                class="peer w-full border-b-2 border-slate-200 bg-transparent pl-10 pr-12 pt-5 pb-2 text-sm text-text-primary transition-colors duration-300 placeholder:text-transparent focus:border-primary/30 focus:outline-none autofill:text-text-primary"
                            />
                            <label
                                for="contraseña"
                                class="pointer-events-none absolute left-10 top-1/2 -translate-y-1/2 text-sm text-text-muted transition-all duration-300 ease-out peer-focus:top-1.5 peer-focus:translate-y-0 peer-focus:text-[11px] peer-focus:font-semibold peer-focus:tracking-wide peer-focus:text-primary peer-not-placeholder-shown:top-1.5 peer-not-placeholder-shown:translate-y-0 peer-not-placeholder-shown:text-[11px] peer-not-placeholder-shown:font-semibold peer-not-placeholder-shown:text-slate-600"
                            >
                                Contraseña
                            </label>
                            <!-- Línea animada al enfocar -->
                            <span class="pointer-events-none absolute bottom-0 left-0 h-[2px] w-full origin-left scale-x-0 rounded-full bg-gradient-to-r from-primary via-primary-light to-accent transition-transform duration-300 ease-out group-focus-within:scale-x-100" aria-hidden="true"></span>
                            <!-- Mostrar / ocultar contraseña -->
                            <button
                                type="button"
                                data-toggle-password
                                aria-label="Mostrar contraseña"
                                class="absolute inset-y-0 right-1 flex items-center text-slate-400 transition-colors duration-300 hover:text-primary focus:outline-none focus-visible:text-primary"
                            >
                                <svg data-eye class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                </svg>
                                <svg data-eye-off class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
                                </svg>
                            </button>
                        </div>

                        <!-- Botón y enlaces -->
                        <div class="flex flex-col gap-5 pt-4 animate-fadeInUp opacity-0 motion-reduce:animate-none motion-reduce:opacity-100 [animation-delay:0.35s]">
                            <button
                                type="submit"
                                class="group relative w-full overflow-hidden rounded-xl bg-gradient-to-r from-primary to-primary-light px-6 py-3.5 text-sm font-semibold uppercase tracking-widest text-white shadow-lg shadow-primary/25 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-xl hover:shadow-primary/40 hover:brightness-110 active:translate-y-0 active:scale-[0.98] focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-white"
                            >
                                <!-- Brillo que barre el botón al pasar el mouse -->
                                <span class="pointer-events-none absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-white/25 to-transparent transition-transform duration-500 group-hover:translate-x-full" aria-hidden="true"></span>
                                <span class="relative z-10">Ingresar</span>
                            </button>

                            <a
                                href="/admin"
                                class="group inline-flex items-center justify-center gap-2 text-sm font-medium text-slate-500 transition-colors duration-300 hover:text-primary focus:outline-none focus-visible:underline"
                            >
                                <svg class="h-4 w-4 transition-transform duration-300 group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
                                </svg>
                                Volver al inicio
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Footer Flotante -->
        <div class="absolute bottom-6 w-full text-center animate-fadeIn motion-reduce:animate-none [animation-delay:0.5s]">
            <p class="text-xs text-white/70 drop-shadow-sm">
                © {new Date().getFullYear()} Alcaldía de Cochabamba · Manfred Reyes Villa
            </p>
        </div>

    </main>

    <script>
        const btn = document.querySelector('[data-toggle-password]');
        const input = document.getElementById('contraseña');
        btn?.addEventListener('click', () => {
            const mostrar = input.type === 'password';
            input.type = mostrar ? 'text' : 'password';
            btn.setAttribute('aria-label', mostrar ? 'Ocultar contraseña' : 'Mostrar contraseña');
            btn.querySelector('[data-eye]')?.classList.toggle('hidden', mostrar);
            btn.querySelector('[data-eye-off]')?.classList.toggle('hidden', !mostrar);
        });
    </script>
</AdminLayout>