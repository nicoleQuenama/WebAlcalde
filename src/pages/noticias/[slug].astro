---
/**
 * /noticias/[slug] — Detalle de noticia con HTML semántico (SSR).
 */
import Layout from '@layouts/Layout.astro';
import { getNoticias, getNoticiaBySlug, formatFecha } from '@lib/noticias';
import NoticiasCard from '@components/Noticias/NoticiasCard.astro';

export const prerender = false;

const { slug } = Astro.params;
const noticia = getNoticiaBySlug(slug!);

if (!noticia) {
  return Astro.redirect('/noticias');
}

// Relacionadas: misma categoría, excluir actual
const relacionadas = getNoticias()
  .filter((n) => n.categoria === noticia.categoria && n.slug !== noticia.slug)
  .slice(0, 3);
---

<Layout title={`${noticia.titulo} — Noticias`}>
  <main class="bg-white">
    <!-- Breadcrumb semántico -->
    <nav aria-label="Breadcrumb" class="mx-auto max-w-4xl px-6 pt-24 lg:px-8">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-slate-500">
        <li><a href="/" class="hover:text-primary hover:underline">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/noticias" class="hover:text-primary hover:underline">Noticias</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="font-semibold text-slate-900 line-clamp-1">{noticia.titulo}</li>
      </ol>
    </nav>

    <!-- Artículo principal -->
    <article class="mx-auto max-w-4xl px-6 py-8 lg:px-8 lg:py-12">
      <header>
        <div class="flex flex-wrap items-center gap-3">
          <span class="rounded-full bg-primary px-3 py-1 text-[11px] font-bold uppercase tracking-[0.14em] text-white">
            {noticia.categoria}
          </span>
          <time datetime={noticia.fecha} class="text-xs font-medium uppercase tracking-[0.14em] text-slate-500">
            {formatFecha(noticia.fecha)}
          </time>
        </div>
        <h1 class="mt-4 text-[2rem] font-black leading-[1.05] tracking-tight text-slate-900 sm:text-4xl lg:text-[2.6rem]">
          {noticia.titulo}
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-slate-600">
          {noticia.resumen}
        </p>
        {noticia.autor && (
          <p class="mt-3 text-xs font-semibold uppercase tracking-[0.14em] text-slate-400">Por {noticia.autor}</p>
        )}
      </header>

      <figure class="mt-8 overflow-hidden rounded-2xl border border-slate-200">
        <img
          src={noticia.imagen}
          alt={noticia.imagenAlt}
          width="1200"
          height="800"
          loading="eager"
          class="aspect-[16/9] w-full object-cover"
        />
        <figcaption class="bg-slate-50 px-4 py-2 text-xs italic text-slate-500">
          {noticia.imagenAlt}
        </figcaption>
      </figure>

      <div class="prose prose-slate mt-8 max-w-none prose-p:leading-relaxed prose-p:text-slate-700">
        <p>{noticia.contenido}</p>
        <p>
          Esta noticia forma parte de la cobertura permanente de la Alcaldía de Cochabamba sobre gestión,
          cultura y obras que transforman la ciudad. Sigue explorando para conocer más historias.
        </p>
      </div>

      <div class="mt-10 flex flex-wrap gap-3">
        <a
          href="/noticias"
          class="inline-flex items-center gap-2 rounded-full border border-slate-200 px-5 py-2.5 text-xs font-bold uppercase tracking-[0.14em] text-slate-700 transition hover:border-slate-900 hover:text-slate-900"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Volver a noticias
        </a>
        <button
          type="button"
          onclick="if(navigator.share){navigator.share({title: document.title, url: location.href})}else{navigator.clipboard.writeText(location.href); alert('Enlace copiado')}"
          class="inline-flex items-center gap-2 rounded-full bg-primary px-6 py-2.5 text-xs font-bold uppercase tracking-[0.14em] text-white transition hover:bg-primary-deep"
        >
          Compartir
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="M8.5 13.5L15.5 6.5M15.5 17.5L8.5 10.5" stroke-linecap="round"/></svg>
        </button>
      </div>
    </article>

    <!-- Relacionadas -->
    {relacionadas.length > 0 && (
      <section aria-labelledby="relacionadas-title" class="border-t border-slate-200 bg-slate-50 py-12">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
          <h2 id="relacionadas-title" class="text-lg font-bold tracking-tight text-slate-900">Noticias relacionadas</h2>
          <ul role="list" class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {relacionadas.map((n) => (
              <li class="flex">
                <NoticiasCard noticia={n} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}
  </main>
</Layout>
