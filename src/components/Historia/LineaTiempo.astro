---
import { HISTORIA, HISTORIA_INTRO } from '../../constants/historia';
import TimelineGaleria from './TimelineGaleria';

// A cada hito con foto le asignamos su posición dentro de la galería (mismo orden
// que TimelineGaleria.tsx). Los que no tienen foto quedan con `galeriaIdx: null`.
let cuentaImg = 0;
const hitos = HISTORIA.map((hito) => ({
  ...hito,
  galeriaIdx: hito.imagen ? cuentaImg++ : null,
}));
---

<section class="relative bg-white text-slate-900">
  <div class="mx-auto max-w-6xl px-6 py-24 lg:px-8 lg:py-32">
    <!-- Encabezado (alineado a la izquierda, sin centrar todo) -->
    <header class="max-w-2xl">
      <p class="text-[11px] font-semibold uppercase tracking-[0.34em] text-[#454ca5]">
        {HISTORIA_INTRO.kicker}
      </p>
      <h2 class="mt-4 text-[1.9rem] font-bold leading-[1.08] tracking-tight sm:text-4xl lg:text-[2.75rem]">
        {HISTORIA_INTRO.titulo}
      </h2>
      <p class="mt-5 text-base leading-relaxed text-slate-600 lg:text-lg">
        {HISTORIA_INTRO.bajada}
      </p>
    </header>

    <ol class="relative mt-16 lg:mt-24" data-linea-tiempo>
      <!-- Riel base + avance de scroll -->
      <span aria-hidden="true" class="absolute left-3 top-2 bottom-8 w-px bg-slate-200"></span>
      <span
        aria-hidden="true"
        data-riel-avance
        class="absolute left-3 top-2 bottom-8 w-px origin-top scale-y-0 bg-[#454ca5]/70 transition-transform duration-150 ease-out"
      ></span>

      {
        hitos.map((hito, i) => (
          <li
            data-hito
            class="relative pb-14 pl-10 last:pb-0 lg:grid lg:grid-cols-[5rem_19rem_1fr] lg:items-start lg:gap-x-10 lg:pl-12"
          >
            <span
              aria-hidden="true"
              class="absolute left-3 top-[6px] h-3 w-3 -translate-x-1/2 rounded-full border-2 border-[#454ca5] bg-white"
            />

            {/* Año + etapa */}
            <div class="mb-4 lg:mb-0 lg:pt-[2px] lg:text-right">
              <div class="text-2xl font-bold tracking-tight lg:text-[1.7rem]">{hito.anio}</div>
              <div class="mt-1 text-[10px] font-semibold uppercase tracking-[0.22em] text-slate-400">
                {hito.etapa}
              </div>
            </div>

            {/* Imagen — si hay foto, abre la galería a pantalla completa */}
            {hito.imagen ? (
              <button
                type="button"
                data-galeria-idx={hito.galeriaIdx}
                aria-label={`Ampliar foto: ${hito.titulo}`}
                class="group mb-4 block w-full cursor-zoom-in overflow-hidden rounded-xl border border-slate-200 shadow-sm outline-none transition-shadow hover:shadow-md focus-visible:ring-2 focus-visible:ring-[#454ca5]/60 lg:mb-0"
              >
                <span class="relative block aspect-[4/3]">
                  <img
                    src={hito.imagen}
                    alt={hito.imagenAlt ?? hito.titulo}
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
                  />
                  <span class="pointer-events-none absolute right-2 top-2 flex h-7 w-7 items-center justify-center rounded-full bg-black/45 text-white opacity-0 backdrop-blur-sm transition-opacity duration-300 group-hover:opacity-100">
                    <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" /></svg>
                  </span>
                </span>
              </button>
            ) : (
              <figure class="mb-4 overflow-hidden rounded-xl border border-slate-200 shadow-sm lg:mb-0">
                <div class="flex aspect-[4/3] w-full flex-col items-center justify-center gap-1.5 bg-slate-50">
                  <span class="text-[2rem] font-bold leading-none text-slate-300">{hito.anio}</span>
                  <span class="text-[10px] font-semibold uppercase tracking-[0.2em] text-slate-400">
                    Foto de archivo
                  </span>
                </div>
              </figure>
            )}

            {/* Contenido */}
            <div class="lg:pt-[2px]">
              <span class="font-mono text-xs text-slate-400">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-1 text-lg font-bold tracking-tight lg:text-xl">{hito.titulo}</h3>
              <p class="mt-2 max-w-prose text-[15px] leading-relaxed text-slate-600">
                {hito.descripcion}
              </p>
            </div>
          </li>
        ))
      }

      <!-- Cierre abierto -->
      <li class="relative pl-10 lg:pl-12">
        <span
          aria-hidden="true"
          class="absolute left-3 top-1 h-3.5 w-3.5 -translate-x-1/2 rounded-full bg-[#454ca5] ring-4 ring-white"
        ></span>
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-[#454ca5]">
          2026 · gestión en curso
        </p>
      </li>
    </ol>
  </div>

  {/* Galería a pantalla completa para las fotos de la línea de tiempo */}
  <TimelineGaleria client:idle />
</section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    [data-linea-tiempo][data-anim] [data-hito] {
      opacity: 0;
      transform: translateY(1.25rem);
      transition: opacity 0.7s ease, transform 0.7s ease;
    }
    [data-linea-tiempo][data-anim] [data-hito].is-visible {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  const ol = document.querySelector<HTMLElement>('[data-linea-tiempo]');
  if (ol) {
    const hitos = Array.from(ol.querySelectorAll<HTMLElement>('[data-hito]'));
    const riel = ol.querySelector<HTMLElement>('[data-riel-avance]');

    // Aparición progresiva (solo si hay JS y el usuario no pidió menos movimiento)
    ol.setAttribute('data-anim', '');
    const io = new IntersectionObserver(
      (entradas) => {
        entradas.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('is-visible');
            io.unobserve(e.target);
          }
        });
      },
      { rootMargin: '0px 0px -12% 0px', threshold: 0.12 },
    );
    hitos.forEach((h) => io.observe(h));

    // Avance del riel según el scroll dentro de la lista
    if (riel) {
      let pendiente = false;
      const actualizar = () => {
        pendiente = false;
        const r = ol.getBoundingClientRect();
        const avance = Math.min(
          Math.max((window.innerHeight * 0.55 - r.top) / r.height, 0),
          1,
        );
        riel.style.transform = `scaleY(${avance})`;
      };
      const alScroll = () => {
        if (pendiente) return;
        pendiente = true;
        requestAnimationFrame(actualizar);
      };
      window.addEventListener('scroll', alScroll, { passive: true });
      window.addEventListener('resize', alScroll, { passive: true });
      actualizar();
    }
  }
</script>
