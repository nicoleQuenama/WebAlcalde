---
import Card from '@components/About/InstitutionalProfile/Card.component.astro';
import { INSTITUTIONAL_CARDS } from '@constants/institutionalProfile/content';
import { efectivoLista } from '@lib/cms/resolve';

const { class: extraClass } = Astro.props;

const Z_INDEX: Record<string, number> = { mision: 2, vision: 1 };
// El CMS (beta) solo permite editar el texto de estas dos tarjetas, nunca
// agregar/quitar/reordenar: la animación GSAP de abajo asume exactamente
// dos tarjetas con estos ids.
const CARDS = efectivoLista('sobre_institutional', INSTITUTIONAL_CARDS);
---

<div
  class:list={[
    'relative mx-auto w-[min(1080px,100%)] overflow-visible mt-4 md:mt-6 h-[clamp(440px,118vw,520px)] md:h-[clamp(340px,45vh,420px)] lg:h-[clamp(360px,48vh,460px)]',
    extraClass,
  ]}
  data-stage
>
  {CARDS.map((card) => (
    <div
      class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2"
      style={`z-index: ${Z_INDEX[card.id] ?? 1};`}
      data-slot={card.id}
      data-cms-dominio="sobre_institutional"
      data-cms-clave={card.id}
    >
      <Card
        title={card.title}
        eyebrow={card.eyebrow}
        description={card.body}
        data-card={card.id}
      />
    </div>
  ))}
</div>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  gsap.matchMedia().add(
    {
      desktop: '(min-width: 861px)',
      tablet: '(min-width: 561px) and (max-width: 860px)',
      mobile: '(max-width: 560px)',
    },
    (ctx) => {
      const stage = document.querySelector<HTMLElement>('[data-stage]');
      if (!stage) return;

      const cardEls = Array.from(stage.querySelectorAll<HTMLElement>('[data-card]'));
      if (cardEls.length === 0) return;

      const byId = new Map(cardEls.map((el) => [el.dataset.card, el]));
      const mision = byId.get('mision');
      const vision = byId.get('vision');
      if (!mision || !vision) return;

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const mobile = !!ctx.conditions?.mobile;
      const dir = mobile ? 'vertical' : 'horizontal';
      const GAP = mobile ? 14 : 20;

      const w = mision.offsetWidth;
      const h = mision.offsetHeight;
      const side = dir === 'vertical' ? h : w;
      const overlap = Math.round(side * 0.62);

      const computeSpread = () => {
        // Antes: h*1.1 y w+GAP*2 separaba ~380px. Ahora quedan unidas con gap = GAP
        if (dir !== 'horizontal') return Math.round(h / 2 + GAP / 2 + 4);
        const W = stage.offsetWidth;
        const ideal = w / 2 + GAP / 2 + 4;
        const max = (W - w) / 2 - 8;
        return Math.round(Math.max(0, Math.min(ideal, Math.max(0, max))));
      };
      let spread = computeSpread();
      ScrollTrigger.addEventListener('refreshInit', () => {
        spread = computeSpread();
      });

      const setFinal = () => {
        if (dir === 'vertical') {
          gsap.set(mision, { x: 0, y: -spread, rotation: 0, scale: 1, opacity: 1 });
          gsap.set(vision, { x: 0, y: spread, rotation: 0, scale: 1, opacity: 1 });
        } else {
          gsap.set(mision, { x: -spread, y: 0, rotation: 0, scale: 1, opacity: 1 });
          gsap.set(vision, { x: spread, y: 0, rotation: 0, scale: 1, opacity: 1 });
        }
      };

      if (reduce) {
        setFinal();
        return;
      }

      const tl = gsap.timeline({
        defaults: { ease: 'none' },
        scrollTrigger: {
          trigger: stage,
          start: 'top 85%',
          end: '+=380',
          scrub: 1,
        },
      });

      tl.fromTo(
        mision,
        { x: dir === 'vertical' ? 0 : -overlap, y: dir === 'vertical' ? 0 : 0, rotation: -2.5, scale: 0.88, opacity: 0.9 },
        { x: dir === 'vertical' ? 0 : () => -spread, y: dir === 'vertical' ? () => -spread : 0, rotation: 0, scale: 1, opacity: 1 },
        0
      )
        .fromTo(
          vision,
          { x: dir === 'vertical' ? 0 : overlap, y: 0, rotation: 2.5, scale: 0.88, opacity: 0.9 },
          { x: dir === 'vertical' ? 0 : () => spread, y: dir === 'vertical' ? () => spread : 0, rotation: 0, scale: 1, opacity: 1 },
          0
        )
    }
  );
</script>