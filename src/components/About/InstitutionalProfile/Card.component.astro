---
interface Props {
  title: string;
  subtitle?: string;
  description: string;
  eyebrow?: string;
  class?: string;
}

const { title, subtitle, description, eyebrow, class: extraClass, 'data-card': dataCard } = Astro.props;
---

<article
  data-card={dataCard}
  class:list={[
    'relative flex min-h-[210px] w-[min(86vw,320px)] flex-col gap-3 rounded-[18px] px-[clamp(22px,3.5vw,30px)] py-[clamp(22px,3.5vw,30px)] border border-white/15 bg-[#3a2568] text-[#ece7f6] will-change-transform md:w-[min(40vw,270px)] md:min-h-[240px] md:rounded-[16px] lg:min-h-[300px] lg:w-[clamp(250px,26vw,300px)] lg:rounded-[20px]',
    extraClass,
  ]}
>
  {eyebrow && (
    <p class="text-[0.72rem] font-bold uppercase tracking-[2.5px] text-[#c9b8e8]">{eyebrow}</p>
  )}
  <h3 class="text-[clamp(1.35rem,4vw,1.6rem)] font-extrabold tracking-[0.3px] text-white">
    {title}
  </h3>
  {subtitle && <p class="text-sm font-semibold text-[#d4cbe8]">{subtitle}</p>}
  <p class="text-[0.95rem] leading-[1.6] text-[#b9b9d6]">{description}</p>
</article>