---
import type { HeroProps } from './types';
import CarouselFondo from '@components/Home/Carousel/index.astro';

const { fondoSrc, fotosFondo, eyebrow, titulo, subtitulo, quote, style, dominio } = Astro.props as HeroProps & {
    style?: string;
    dominio?: string;
};

const usaCarrusel = !!fotosFondo && fotosFondo.length > 0;
---

<section
    class="relative flex min-h-[100svh] w-full items-center justify-center bg-primary px-0 pb-16 pt-24 lg:pt-28"
    style={style}
    data-cms-dominio={dominio}
>
    <div class="absolute inset-0 z-0 overflow-hidden">
        {usaCarrusel ? (
            <CarouselFondo fotos={fotosFondo} />
        ) : (
            <div
                class="absolute inset-0 scale-110 bg-cover bg-center opacity-40 blur-xl"
                style={`background-image: url('${fondoSrc}');`}
            ></div>
        )}
        <div class="absolute inset-0 bg-primary/25 mix-blend-multiply"></div>
        <div class="absolute inset-0 bg-gradient-to-br from-hero-from via-hero-via to-hero-to opacity-30"></div>
    </div>

    <!-- Contenido -->
    <div
        class={`relative z-10 mx-auto w-full max-w-7xl px-6 lg:px-12 ${
            usaCarrusel ? '' : 'grid grid-cols-1 items-center gap-16 lg:grid-cols-2'
        }`}
    >
        {!usaCarrusel && (
            <div class="flex w-full justify-center">
                <slot name="media" />
            </div>
        )}

        <!-- Textos -->
        <div
            class={`flex flex-col space-y-6 text-center ${
                usaCarrusel ? 'items-center' : 'items-center lg:items-start lg:text-left'
            }`}
        >
            <!-- Eyebrow (máquina de escribir 1) -->
            <div class="relative w-max max-w-full">
                <p class="invisible whitespace-nowrap pr-2 font-roboto-serif text-[11px] uppercase tracking-[0.14em] opacity-0 sm:text-sm sm:tracking-[0.2em]">
                    {eyebrow}
                </p>
                <p
                    class="typewriter-1 absolute left-0 top-0 h-full overflow-hidden whitespace-nowrap pr-2 font-roboto-serif text-[11px] uppercase tracking-[0.14em] text-accent sm:text-sm sm:tracking-[0.2em]"
                    data-cms-campo="eyebrow"
                >
                    {eyebrow}
                </p>
            </div>

            <!-- Título (máquina de escribir 2) -->
            <div class="relative w-max max-w-full">
                <h1 class="invisible whitespace-nowrap py-1 pr-4 font-roboto-serif text-4xl leading-[1.1] text-white opacity-0 sm:text-5xl lg:text-7xl">
                    {titulo}
                </h1>
                <h1
                    class="typewriter-2 absolute left-0 top-0 h-full overflow-hidden whitespace-nowrap py-1 font-serif text-3xl leading-[1.1] text-white sm:text-4xl lg:text-6xl"
                    data-cms-campo="titulo"
                >
                    {titulo}
                </h1>
            </div>
            <slot />
        </div>
    </div>
</section>
