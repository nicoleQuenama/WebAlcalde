---
import CardsDeck from './CardsDeck';
import ArrowDeckCards from '@components/ui/ArrowButton/ArrowDeckCards.component.astro';
import type { CardData } from './CardsDeck';

interface Props {
  cards: CardData[];
  class?: string;
}
const { cards, class: className = '' } = Astro.props;
---
<div class={`cards-deck-group relative w-full ${className}`}>
  <ArrowDeckCards />
  <CardsDeck cards={cards} client:visible />
</div>