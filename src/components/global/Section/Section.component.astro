---
interface Props{
    title?:string;
    subtitle?:string;
    description?:string;
    //tema de color del tipo banner
    theme?: 'white' | 'purple' | 'transparent';
    class?:string;
    /** CSS inline (ej. `order:N` para el layout arrastrable del CMS beta). */
    style?:string;
    /** Si se define, marca la sección como editable: `data-cms-dominio` + `data-cms-campo` en kicker/título/párrafo. */
    dominio?:string;
    /** Override del padding vertical del `<section>` (default: el de siempre). */
    paddingClass?:string;
    /** Override del espacio entre la cabecera y el contenido del slot (default: el de siempre). */
    headerGapClass?:string;
}

const{
    title,
    subtitle,
    description,
    theme = 'white',
    class: className = '',
    style,
    dominio,
    paddingClass = 'py-16 lg:py-24',
    headerGapClass = 'mb-12',
} = Astro.props;


//temas
const themeStyles = {
    white:{
        bg:'bg-white',
        title: 'text-slate-900',
        subtitle:'text-primary',
        desc: 'text-slate-600',
    },
    purple:{
        bg: 'bg-primary',
        title: 'text-white',
        subtitle:'text-accent',
        desc:'text-white/75',
    },
    transparent:{
        bg: 'bg-transparent',
        title: 'text-slate-900',
        subtitle:'text-primary',
        desc: 'text-slate-600',
    },
    dark:{
      bg: 'bg-transparent',
      title: 'text-salte-900',
      subtitle:'text-slate-300',
      desc:'text-slate-400',
    }
};
const currentTheme = themeStyles[theme];
---

<!-- aplicacion al contendor-->
<section class={`w-full ${paddingClass} ${currentTheme.bg} ${className}`} style={style} data-cms-dominio={dominio}>
  <div class="mx-auto max-w-5xl px-6 lg:px-8">

    <!-- Cabecera de la sección -->
    {(title || subtitle || description) && (
      <header class={`max-w-2xl ${headerGapClass}`}>
        {subtitle && (
          <p class={`text-[11px] font-semibold uppercase tracking-[0.34em] ${currentTheme.subtitle}`} data-cms-campo="kicker">
            {subtitle}
          </p>
        )}
        {title && (
          <h2 class={`mt-4 text-[1.9rem] font-bold leading-[1.08] tracking-tight sm:text-4xl ${currentTheme.title}`} data-cms-campo="titulo">
            {title}
          </h2>
        )}
        {description && (
          <p class={`mt-4 max-w-xl text-base leading-relaxed ${currentTheme.desc}`} data-cms-campo="parrafo" data-cms-multilinea>
            {description}
          </p>
        )}
      </header>
    )}

    <div class="w-full">
      <slot />
    </div>

  </div>
</section>