---
/**
 * Hero — cabecera reutilizable (home y /sobre).
 *
 * Mismo diseño (carrusel de imágenes grandes + máquina de escribir sobre el
 * color de marca), con el texto por props para que cada página muestre lo suyo:
 *   - home  → título del libro + nombre del alcalde.
 *   - sobre → biografía/trayectoria + nombre del alcalde + una cita.
 */
import HeroCards from './HeroCard.tsx';
import type { TarjetaImagen } from './HeroCard.tsx';
import '../../styles/sobre.css';
import '../../styles/global.css';

interface Props {
  /** Línea superior (máquina de escribir 1). */
  eyebrow: string;
  /** Título grande (máquina de escribir 2). */
  titulo: string;
  /** Cita opcional debajo del título. */
  cita?: string;
  /** Imágenes del carrusel. Si no se pasan, usa 4 fotos de gente. */
  imagenes?: TarjetaImagen[];
}
const { eyebrow, titulo, cita, imagenes } = Astro.props;

// Rutas con espacios → codificadas. Fotos de escena (no retratos solos).
const GENTE =
  '/Mas%20Recursos/1.%20Recursos%20para%20el%20alcalde/1.2%20Fotograf%C3%ADas%20interactuando%20con%20la%20gente/';

const imagenesPorDefecto: TarjetaImagen[] = [
  { id: 'gente-1', src: GENTE + '6P9A5493.jpg', titulo: 'Con la gente' },
  { id: 'gente-2', src: GENTE + 'IMG_2941.jpg', titulo: 'En los barrios' },
  { id: 'gente-3', src: GENTE + 'apoyo%20de%20la%20gente%20al%20alcalde.jpg', titulo: 'Cerca de los vecinos' },
  { id: 'gente-4', src: GENTE + 'IMG_7166.jpg', titulo: 'En cada distrito' },
];
const imgs = imagenes ?? imagenesPorDefecto;
---

<section class="relative flex min-h-[90vh] w-full items-center justify-center overflow-hidden bg-[#472d82] pt-20">
  <!-- Fondo: panorámica desenfocada + velo del color de marca (sin sombras) -->
  <div class="absolute inset-0 z-0">
    <div
      class="absolute inset-0 scale-110 bg-cover bg-center opacity-40 blur-xl"
      style="background-image: url('/multimedia/cochaPanoramica.jpeg');"
    >
    </div>
    <div class="absolute inset-0 bg-[#472d82]/80 mix-blend-multiply"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-[#472d82]/40 to-[#472d82]"></div>
  </div>

  <!-- Contenido -->
  <div class="relative z-10 mx-auto grid w-full max-w-7xl grid-cols-1 items-center gap-16 px-6 lg:grid-cols-2 lg:px-12">
    <!-- Columna izquierda: carrusel de imágenes grandes -->
    <div class="flex w-full justify-center">
      <HeroCards client:load imagenes={imgs} autoplayMs={4500} />
    </div>

    <!-- Columna derecha: textos -->
    <div class="flex flex-col items-center space-y-6 text-center lg:items-start lg:text-left">
      <!-- Máquina de escribir 1 -->
      <div class="relative w-max max-w-full">
        <p class="invisible whitespace-nowrap pr-2 font-roboto-serif text-[11px] uppercase tracking-[0.14em] opacity-0 sm:text-sm sm:tracking-[0.2em]">
          {eyebrow}
        </p>
        <p class="typewriter-1 absolute left-0 top-0 h-full overflow-hidden whitespace-nowrap pr-2 font-roboto-serif text-[11px] uppercase tracking-[0.14em] text-[#c9b8e8] sm:text-sm sm:tracking-[0.2em]">
          {eyebrow}
        </p>
      </div>

      <!-- Máquina de escribir 2 -->
      <div class="relative w-max max-w-full">
        <h1 class="invisible whitespace-nowrap py-1 pr-4 font-roboto-serif text-4xl leading-[1.1] text-white opacity-0 sm:text-5xl lg:text-7xl">
          {titulo}
        </h1>
        <h1 class="typewriter-2 absolute left-0 top-0 h-full overflow-hidden whitespace-nowrap py-1 font-serif text-3xl leading-[1.1] text-white sm:text-4xl lg:text-6xl">
          {titulo}
        </h1>
      </div>

      {cita && (
        <p class="fade-right-delay border-l-4 border-[#c9b8e8] pl-6 font-roboto-serif text-lg italic text-white/85 sm:text-xl lg:text-2xl">
          "{cita}"
        </p>
      )}
    </div>
  </div>
</section>
