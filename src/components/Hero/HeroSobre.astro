---
import HeroCards from './HeroCard.tsx';
import '../../styles/sobre.css';
import '../../styles/global.css';
---
<section class="relative w-full min-h-[90vh] flex items-center justify-center overflow-hidden bg-slate-900 pt-20">
  
  <!-- Fondo -->
  <div class="absolute inset-0 z-0">
    <div 
      class="absolute inset-0 bg-cover bg-center scale-110 blur-xl opacity-60" 
      style="background-image: url('/multimedia/cochaPanoramica.jpeg');">
    </div>
    <div class="absolute inset-0 bg-indigo-950/60 mix-blend-multiply"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-transparent to-slate-900/90"></div>
  </div>

  <!-- Contenido Principal -->
  <div class="relative z-10 w-full max-w-7xl mx-auto px-6 lg:px-12 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
    
    <!-- Columna Izquierda: Cartas Interactivas -->
    <div class="w-full flex justify-center">
      <HeroCards client:load />
    </div>

    <!-- Columna Derecha: Textos-->
    <div class="text-center lg:text-left flex flex-col items-center lg:items-start space-y-6">
      
      <!-- Máquina de Escribir-->
      <div class="relative w-max">
        <p class="opacity-0 invisible whitespace-nowrap font-roboto-serif uppercase tracking-[0.2em] text-sm lg:text-base pr-2">
          Conoce más de
        </p>
        <p class="typewriter-1 absolute top-0 left-0 h-full overflow-hidden whitespace-nowrap text-purple-300 font-roboto-serif uppercase tracking-[0.2em] text-sm lg:text-base pr-2">
          Conoce más de
        </p>
      </div>
      
      <!--Texto 2-->
      <div class="relative w-max max-w-full">
        <h1 class="opacity-0 invisible whitespace-nowrap text-4xl sm:text-5xl lg:text-7xl font-roboto-serif text-white drop-shadow-lg leading-[1.1] py-1 pr-4">
          Manfred Reyes Villa
        </h1>
        <h1 class="typewriter-2 absolute top-0 left-0 h-full overflow-hidden whitespace-nowrap text-3xl sm:text-4xl lg:text-6xl font-serif text-white drop-shadow-lg leading-[1.1] py-1">
          Manfred Reyes Villa
        </h1>
      </div>
      
      <!--Texto 3-->
      <div class="relative w-full">
        <p class="fade-right-delay text-slate-300 text-lg sm:text-xl lg:text-2xl font-roboto-serif italic border-l-4 border-purple-500 pl-6">
          "Cocha la mejor ciudad de Bolivia"
        </p>
      </div>
    </div>
  </div>
</section>