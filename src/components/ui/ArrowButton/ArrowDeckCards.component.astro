---
import ArrowButton from './ArrowButton';
---

<div class="pointer-events-none absolute left-0 top-1/2 z-50 flex w-full -translate-y-1/2 justify-between px-4">
    <div class="pointer-events-auto left-arrow transition-transform duration-300 ease-in-out hover:-translate-x-1">
        <ArrowButton
            direction="left"
            variant="hero"
            aria-label="Ver carta anterior"
            client:load
        />
    </div>

    <div class="pointer-events-auto right-arrow transition-transform duration-300 ease-in-out hover:translate-x-1">
        <ArrowButton
            direction="right"
            variant="hero"
            aria-label="Ver carta siguiente"
            client:load
        />
    </div>
</div>

<script>
    const leftBtn = document.querySelector<HTMLDivElement>('.left-arrow');
    const rightBtn = document.querySelector<HTMLDivElement>('.right-arrow');

    leftBtn?.addEventListener('click', (event: MouseEvent) => {
        event.preventDefault();
        document.dispatchEvent(new CustomEvent('deck:prevSlide'));
    });
    rightBtn?.addEventListener('click', (event: MouseEvent) => {
        event.preventDefault();
        document.dispatchEvent(new CustomEvent('deck:nextSlide'));
    });
</script>