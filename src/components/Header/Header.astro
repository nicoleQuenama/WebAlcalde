---
import type { NavItem } from '../../types/nav';
import HeaderMovil from './HeaderMovil.tsx';

// Menú: "Agenda" se quitó del sitio.
const enlacesMenu: NavItem[] = [
    { nombre: 'Inicio', ruta: '/' },
    { nombre: 'Sobre', ruta: '/sobre' },
    { nombre: 'Gestión', ruta: '/gestion' },
    { nombre: 'Noticias', ruta: '/noticias' },
    { nombre: 'Buzón Ciudadano', ruta: '/buzon' }
];
---

<header>
    <HeaderMovil enlaces={enlacesMenu} client:load />
</header>