---
import Hero from '@components/global/Hero/Hero.astro';
import HeroCards from '@components/global/Hero/HeroCard';
import type { TarjetaImagen } from '@components/global/Hero/HeroCard';

// Importamos directamente las carpetas (leemos sus index.astro)
import BiographyVideo from './BiographyVideo/index.astro';
import ComparatingProjects from './ComparatingProjects/index.astro';
import BookSection from './BookSection/index.astro';

// Tipos
import type { ParComparador } from './ComparatingProjects/ProjectSlide';
import type { BookProps } from './BookSection/Book3D';
import './home.css';

interface Props {
  imagenesHero: TarjetaImagen[];
  fondoSrc: string;
  videoBiografia: string;
  posterBiografia: string;
  paresComparador: ParComparador[];
  bookProps: BookProps;
  autoplayMs?: number;
}

const {
  imagenesHero,
  fondoSrc,
  videoBiografia,
  posterBiografia,
  paresComparador,
  bookProps,
  autoplayMs = 4500,
} = Astro.props;
---

<main class="w-full">
  <Hero fondoSrc={fondoSrc} eyebrow="Cocha, la mejor ciudad de Bolivia" titulo="Manfred Reyes Villa">
    <HeroCards slot="media" imagenes={imagenesHero} autoplayMs={autoplayMs} client:load />
  </Hero>

  <BiographyVideo videoBiografia={videoBiografia} posterBiografia={posterBiografia} />
  
  <ComparatingProjects pares={paresComparador} />
  
  <BookSection bookProps={bookProps} />
</main>