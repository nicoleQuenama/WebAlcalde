---
import Hero from '@components/global/Hero/Hero.astro';
import type { FotoFondo } from './Carousel/types';

import BiographyVideo from './BiographyVideo/index.astro';
import ComparatingProjects from './ComparatingProjects/index.astro';
import BookSection from './BookSection/index.astro';

// Tipos
import type { ParComparador } from './ComparatingProjects/ProjectSlide';
import type { BookProps } from './BookSection/Book3D';
import './home.css';

interface Props {
  fotosFondo: FotoFondo[];
  fondoSrc: string;
  videoBiografia: string;
  posterBiografia: string;
  paresComparador: ParComparador[];
  bookProps: BookProps;
}

const {
  fotosFondo,
  fondoSrc,
  videoBiografia,
  posterBiografia,
  paresComparador,
  bookProps,
} = Astro.props;
---

<main class="w-full">
  <Hero fotosFondo={fotosFondo} fondoSrc={fondoSrc} eyebrow="Cocha, la mejor ciudad de Bolivia" titulo="Manfred Reyes Villa" />
  
  <BiographyVideo videoBiografia={videoBiografia} posterBiografia={posterBiografia} />
  
  <ComparatingProjects pares={paresComparador} />
  
  <BookSection bookProps={bookProps} />
</main>