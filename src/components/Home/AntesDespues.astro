---
/**
 * AntesDespues — sección "antes / después" del home (bloque CLARO).
 *
 * Ilustra "Cómo ha crecido Cochabamba: de una ciudad de ayer a una que mira al
 * futuro". Un solo comparador grande con flechas a los costados para recorrer
 * todos los pares (componente <ComparadorAntesDespues>).
 *
 * ⚠️ No hay fotos históricas todavía: pares de fotos actuales como marcador.
 *    TODO: cargar los pares antes/después reales.
 */
import { getImage } from 'astro:assets';
import ComparadorAntesDespues from './ComparadorAntesDespues';
import type { ParComparador } from './ComparadorAntesDespues';
import { MEDIA } from '../../constants/media';

const opt = async (src: string, height?: number) =>
  (
    await getImage({
      src,
      inferSize: !height,
      width: 1200,
      ...(height ? { height } : {}),
      format: 'webp',
    })
  ).src;

// Pares reales antes/ahora del bucket (imagenes/cocha-antes-y-ahora), optimizados en build.
const pares: ParComparador[] = await Promise.all(
  MEDIA.antesDespues.map(async (p) => ({
    titulo: p.titulo,
    antes: await opt(p.antes),
    despues: await opt(p.despues, p.despuesHeight),
    afterFit: p.afterFit,
    afterPosition: p.afterPosition,
    afterScale: p.afterScale,
  })),
);
---

<section class="bg-white">
  <div class="mx-auto max-w-5xl px-6 py-20 lg:px-8 lg:py-28">
    <header class="max-w-2xl">
      <p class="text-[11px] font-semibold uppercase tracking-[0.34em] text-[#472d82]">
        Antes y después
      </p>
      <h2 class="mt-4 text-[1.9rem] font-bold leading-[1.08] tracking-tight text-slate-900 sm:text-4xl">
        De una ciudad de ayer a una que mira al futuro
      </h2>
      <p class="mt-4 max-w-xl text-base leading-relaxed text-slate-600">
        Desliza el tirador para comparar cada punto; usa las flechas para pasar al siguiente.
      </p>
    </header>

    <div class="mt-12">
      <ComparadorAntesDespues client:visible pares={pares} />
    </div>
  </div>
</section>
