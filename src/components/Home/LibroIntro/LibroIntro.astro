---
import Section from '@components/global/Section/Section.component.astro';
import FlipBook from '@components/FlipBook/FlipBook';
import Book, { type IMG, type Video } from '@components/Home/BookSection';
import type { Capitulo, EraTemario } from '@lib/db';
import type { TocGroup } from '@type/flipBook';
import type { DEFAULT_FLIPBOOK_META } from '@cms/sitio/defaults';

interface Props {
    libro: typeof DEFAULT_FLIPBOOK_META;
    chapters: Capitulo[];
    eras: EraTemario[];
    photos: IMG[];
    videos: Video[];
    toc: TocGroup[];
    style?: string;
    dominio?: string;
}

const { libro, chapters, eras, photos, videos, toc, style, dominio } = Astro.props;
---

<Section
    subtitle={libro.kicker}
    description={libro.parrafo}
    paddingClass="py-16 lg:py-20"
    headerGapClass="mb-8"
    style={style}
    dominio={dominio}
>
    <FlipBook
        client:visible
        width={350}
        height={560}
        title={libro.title}
        subtitle={libro.subtitle}
        ctaLabel={libro.ctaLabel}
        coverImage={libro.coverImage}
        coverLabel3D={libro.coverLabel3D}
        toc={toc}
    >
        <Book
            coverImage={libro.coverImage}
            chapters={chapters}
            eras={eras}
            photos={photos}
            videos={videos}
            meta={libro}
        />
    </FlipBook>
</Section>
