---
/**
 * Biografia — bloque de biografía (texto) en /sobre, debajo del hero.
 *
 * El texto sale de la apertura del temario ("Presentación del alcalde").
 * El video está en el home (componente VideoBiografia).
 */
import { PRESENTACION } from '../../constants/temario';
---

<section class="bg-white">
  <div class="mx-auto max-w-3xl px-6 py-20 lg:px-8 lg:py-24">
    <p class="text-[11px] font-semibold uppercase tracking-[0.34em] text-[#472d82]">
      Biografía
    </p>
    <h2 class="mt-4 text-[1.9rem] font-bold leading-[1.08] tracking-tight text-slate-900 sm:text-4xl">
      Una vida dedicada a Cochabamba
    </h2>
    <p class="mt-5 text-base leading-relaxed text-slate-600 lg:text-lg">
      {PRESENTACION.bajada}
    </p>
    <a
      href="/gestion#presentacion"
      class="mt-8 inline-flex items-center gap-2 rounded-full bg-[#472d82] px-6 py-2.5 text-xs font-bold uppercase tracking-[0.14em] text-white transition-transform hover:-translate-y-0.5"
    >
      Ver la gestión completa
      <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    </a>
  </div>
</section>
