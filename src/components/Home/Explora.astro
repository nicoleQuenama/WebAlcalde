---
import { EXPLORA, EXPLORA_TITULO } from '../../constants/home';
---

<section class="bg-[#141227] text-white">
  <div class="mx-auto max-w-6xl px-6 py-24 lg:px-8 lg:py-32">
    <header class="max-w-2xl">
      <p class="text-[11px] font-semibold uppercase tracking-[0.34em] text-[#b6a8e6]">
        {EXPLORA_TITULO.kicker}
      </p>
      <h2 class="mt-4 text-[1.9rem] font-bold leading-[1.08] tracking-tight sm:text-4xl">
        {EXPLORA_TITULO.titulo}
      </h2>
    </header>

    <div class="mt-12 border-t border-white/12 lg:mt-16">
      {
        EXPLORA.map((item, i) => (
          <a
            href={item.href}
            class="group grid grid-cols-[1fr_auto] items-center gap-6 border-b border-white/12 py-9 lg:py-12"
          >
            <div>
              <span class="text-[10px] font-semibold uppercase tracking-[0.3em] text-[#b6a8e6]">
                {String(i + 1).padStart(2, '0')} · {item.etiqueta}
              </span>
              <h3 class="mt-3 text-3xl font-black tracking-tight transition-transform duration-300 group-hover:translate-x-2 sm:text-4xl lg:text-[3.25rem] lg:leading-[1.02]">
                {item.titulo}
              </h3>
              <p class="mt-3 max-w-md text-[15px] leading-relaxed text-white/55">
                {item.descripcion}
              </p>
            </div>
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-white/20 text-white/70 transition-all duration-300 group-hover:border-white group-hover:bg-white group-hover:text-[#141227] lg:h-14 lg:w-14">
              <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
