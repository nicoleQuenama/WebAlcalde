---
import { EJES, EJES_TITULO } from '../../constants/home';
---

<section class="bg-white">
  <div class="mx-auto max-w-6xl px-6 py-24 lg:px-8 lg:py-32">
    <div class="lg:grid lg:grid-cols-[19rem_1fr] lg:gap-16">
      <!-- Columna izquierda: título fijo -->
      <header class="lg:sticky lg:top-28 lg:self-start">
        <p class="text-[11px] font-semibold uppercase tracking-[0.34em] text-[#454ca5]">
          {EJES_TITULO.kicker}
        </p>
        <h2 class="mt-4 text-[2rem] font-bold leading-[1.05] tracking-tight text-slate-900 sm:text-[2.6rem]">
          {EJES_TITULO.titulo}
        </h2>
        <p class="mt-5 max-w-sm text-[15px] leading-relaxed text-slate-500">{EJES_TITULO.bajada}</p>
      </header>

      <!-- Columna derecha: índice numerado -->
      <ol class="mt-14 border-t border-slate-900/10 lg:mt-0">
        {
          EJES.map((eje, i) => (
            <li class="group grid grid-cols-[3rem_1fr] gap-x-5 border-b border-slate-900/10 py-9 transition-colors sm:grid-cols-[5rem_1fr] sm:gap-x-8 lg:py-11">
              <span class="text-2xl font-light tabular-nums text-slate-300 transition-colors group-hover:text-[#454ca5] sm:text-4xl">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div>
                <h3 class="text-xl font-bold tracking-tight text-slate-900 sm:text-2xl">
                  {eje.titulo}
                </h3>
                <p class="mt-3 max-w-xl text-[15px] leading-relaxed text-slate-600">
                  {eje.descripcion}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
