---
/**
 * BiographyVideo — Sección de biografía del home.
 *
 * Diseño asimétrico: texto biográfico a la izquierda (columna angosta),
 * video grande a la derecha (columna amplia). Sin wrapper Section para
 * tener control total del ancho y espaciado.
 */
import VideoPlayer from './VideoPlayer';

interface Props {
    videoBiografia: string;
    posterBiografia: string;
    eyebrow?: string;
    titulo?: string;
    parrafo?: string;
    cta1Label?: string;
    cta1Href?: string;
    cta2Label?: string;
    cta2Href?: string;
    style?: string;
    dominio?: string;
}

const {
    videoBiografia,
    posterBiografia,
    eyebrow = 'Manfred Reyes Villa',
    titulo = 'Biografía',
    parrafo = 'Manfred Reyes Villa es un líder político boliviano con una trayectoria dedicada al desarrollo ' +
        'de Cochabamba. Con experiencia en gestión pública y un compromiso inquebrantable con el ' +
        'progreso de su ciudad, ha impulsado proyectos fundamentales que transforman la vida de los ' +
        'cochabambinos.',
    cta1Label = 'Más sobre mí',
    cta1Href = '/sobre',
    cta2Label = 'Gestión completa',
    cta2Href = '/gestion',
    style,
    dominio,
} = Astro.props;
---

<!-- ═══ BIOGRAFÍA — diseño asimétrico: texto + video grande ═══ -->
<section class="relative overflow-hidden bg-white pt-20 pb-8 lg:pt-28 lg:pb-12" style={style} data-cms-dominio={dominio}>
    <!-- Barra de acento superior -->
    <div class="absolute left-0 top-0 h-1 w-full bg-linear-to-r from-primary via-accent to-primary"></div>

    <div class="mx-auto max-w-7xl px-6 lg:px-12">
        <!-- Grid asimétrico: 5 columnas de texto / 7 de video -->
        <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-16">

            <!-- ═══ COLUMNA IZQUIERDA: Texto biográfico (5/12) ═══ -->
            <div class="space-y-6 lg:col-span-5">
                <!-- Etiqueta -->
                <p class="text-[11px] font-semibold uppercase tracking-[0.34em] text-primary" data-cms-campo="eyebrow">
                    {eyebrow}
                </p>

                <!-- Título -->
                <h2 class="text-[1.9rem] font-bold leading-[1.08] tracking-tight text-slate-900 sm:text-4xl" data-cms-campo="titulo">
                    {titulo}
                </h2>
                <!-- Párrafo biográfico -->
                <p class="text-base leading-relaxed text-slate-600 lg:text-lg" data-cms-campo="parrafo" data-cms-multilinea>
                    {parrafo}
                </p>

                <!-- Botones de acción -->
                <div class="flex flex-wrap gap-4 pt-2">
                    <a href={cta1Href} class="inline-flex items-center justify-center gap-2 rounded-full bg-primary px-6 py-3 text-xs font-bold uppercase tracking-[0.14em] text-white transition-all hover:-translate-y-0.5 hover:bg-primary-deep hover:shadow-lg hover:shadow-primary/30">
                        <span data-cms-campo="cta1Label">{cta1Label}</span>
                        <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                    </a>
                    <a href={cta2Href} class="inline-flex items-center justify-center gap-2 rounded-full bg-primary border-2 border-primary px-6 py-3 text-xs font-bold uppercase tracking-[0.14em] text-white transition-all hover:-translate-y-0.5 hover:bg-primary-deep hover:shadow-lg hover:shadow-primary/30">
                        <span data-cms-campo="cta2Label">{cta2Label}</span>
                        <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                    </a>
                </div>
            </div>

            <!-- ═══ COLUMNA DERECHA: Video grande (7/12) — lazy (solo carga al entrar en viewport) ═══ -->
            <div class="lg:col-span-7">
                <VideoPlayer
                    client:visible
                    src={videoBiografia}
                    poster={posterBiografia}
                    title="Biografía de Manfred Reyes Villa"
                    className="shadow-2xl transition-shadow duration-300 hover:shadow-[0_20px_60px_-15px_rgba(0,0,0,0.2)]"
                />
            </div>
        </div>
    </div>
</section>
