---
import { getImage } from 'astro:assets';
import HeroCards from '../Hero/HeroCard.tsx';
import { PROYECTOS, PROYECTOS_TITULO } from '../../constants/gestion';

const imagenes = await Promise.all(
  PROYECTOS.map(async (p, i) => ({
    id: i,
    src: (
      await getImage({
        src: p.imagen,
        width: 900,
        ...(p.w && p.h ? { height: Math.max(1, Math.round((900 * p.h) / p.w)) } : {}),
        fit: 'cover',
        format: 'webp',
      })
    ).src,
    titulo: p.titulo,
    encuadre: 'centro' as const,
  })),
);

// Un único color (el de marca): el estado se distingue por opacidad, no por otro tono.
const colorEstado: Record<string, string> = {
  'En ejecución': 'bg-white/15 text-white border-white/30',
  Concluido: 'bg-white/[0.06] text-white/75 border-white/20',
  'En diseño': 'bg-white/[0.06] text-white/60 border-white/15',
};
---

<section id="proyectos" class="scroll-mt-20 bg-[#472d82] text-white">
  <div class="mx-auto max-w-6xl px-6 py-24 lg:px-8 lg:py-32">
    <header class="max-w-2xl">
      <p class="text-[11px] font-semibold uppercase tracking-[0.34em] text-[#c9b8e8]">
        {PROYECTOS_TITULO.kicker}
      </p>
      <h2 class="mt-4 text-[1.9rem] font-bold leading-[1.08] tracking-tight sm:text-4xl lg:text-[2.75rem]">
        {PROYECTOS_TITULO.titulo}
      </h2>
      <p class="mt-5 text-base leading-relaxed text-white/65 lg:text-lg">{PROYECTOS_TITULO.bajada}</p>
    </header>

    <!-- Carrusel de tarjetas (mismo formato que la página Sobre) -->
    <div class="mt-10 flex justify-center lg:mt-14">
      <HeroCards client:visible imagenes={imagenes} autoplayMs={4500} foco="centro" />
    </div>

    <!-- Detalle de cada proyecto -->
    <ul class="mt-16 grid gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/10 sm:grid-cols-2">
      {
        PROYECTOS.map((p) => (
          <li class="flex flex-col gap-3 bg-[#472d82] p-7">
            <div class="flex items-center justify-between gap-3">
              <span class="text-[10px] font-semibold uppercase tracking-[0.24em] text-[#c9b8e8]">
                {p.categoria}
              </span>
              <span class={`rounded-full border px-2.5 py-1 text-[10px] font-bold uppercase tracking-[0.12em] ${colorEstado[p.estado] ?? 'border-white/20 text-white/70'}`}>
                {p.estado}
              </span>
            </div>
            <h3 class="text-lg font-bold tracking-tight">{p.titulo}</h3>
            <p class="text-[15px] leading-relaxed text-white/65">{p.descripcion}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
