---
import ValueCards from '../ValueCards/ValueCards';
import { PILARES } from '../../constants/gestion';
---

<section class="bg-white" style="--accent: #8e79d6;">
  <div class="mx-auto max-w-6xl px-6 py-24 lg:px-8 lg:py-28">
    <header class="max-w-2xl">
      <p class="text-[11px] font-semibold uppercase tracking-[0.34em] text-[#454ca5]">
        Quiénes somos
      </p>
      <h2 class="mt-4 text-[1.9rem] font-bold leading-[1.08] tracking-tight text-slate-900 sm:text-4xl">
        Biografía, misión y visión
      </h2>
    </header>

    <!-- 3 tarjetas apiladas que se despliegan con el scroll (mismo efecto de antes) -->
    <ValueCards client:visible cards={PILARES} />
  </div>
</section>
