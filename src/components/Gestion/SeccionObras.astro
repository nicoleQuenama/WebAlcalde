---
/**
 * SeccionObras — una subsección del temario en la página /gestion.
 *
 * Layout pensado para lectura cómoda (UX):
 *   - Imagen de la subsección a un lado (alterna izquierda/derecha según `indice`).
 *   - Título grande + bajada como entradilla.
 *   - Obras en una grilla de 2 columnas, cada una con su año en una píldora,
 *     el nombre destacado y el detalle debajo. Chip "Video" donde corresponde.
 *
 * Diseño en el color de marca (#472d82) como único acento, sin sombras.
 * ⚠️ Las imágenes son de referencia hasta cargar las del proyecto.
 */
import type { SeccionTemario } from '../../constants/temario';

interface Props {
  seccion: SeccionTemario;
  /** Posición dentro de la era: pares → imagen a la izquierda; impares → derecha. */
  indice?: number;
}
const { seccion, indice = 0 } = Astro.props;
// Pares → imagen a la izquierda; impares → imagen a la derecha (ritmo visual).
const imagenDerecha = indice % 2 === 1;
---

<section id={seccion.id} class="scroll-mt-24 border-b border-slate-900/10 py-16 lg:py-20">
  <div class="flex flex-col gap-10 lg:flex-row lg:items-start lg:gap-16">
    <!-- Imagen de la subsección -->
    {seccion.imagen && (
      <figure class:list={['lg:w-[22rem] lg:shrink-0 lg:sticky lg:top-28', imagenDerecha && 'lg:order-2']}>
        <div class="overflow-hidden rounded-2xl border border-slate-200">
          <img
            src={seccion.imagen}
            alt={seccion.imagenAlt ?? seccion.titulo}
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] w-full bg-slate-100 object-cover"
          />
        </div>
        <figcaption class="mt-2 text-xs font-medium italic text-slate-400">
          Imagen de referencia.
        </figcaption>
      </figure>
    )}

    <!-- Texto + obras -->
    <div class="min-w-0 flex-1">
      <h3 class="text-2xl font-bold leading-snug tracking-tight text-slate-900 sm:text-[1.75rem]">
        {seccion.titulo}
      </h3>
      {seccion.bajada && (
        <p class="mt-4 max-w-2xl text-[15px] leading-relaxed text-slate-600 lg:text-base">
          {seccion.bajada}
        </p>
      )}

      <p class="mt-6 text-[11px] font-semibold uppercase tracking-[0.24em] text-[#472d82]">
        {seccion.obras.length} {seccion.obras.length === 1 ? 'obra' : 'obras'}
      </p>

      <ul class="mt-4 grid gap-x-8 gap-y-6 sm:grid-cols-2">
        {
          seccion.obras.map((obra) => (
            <li class="border-t-2 border-slate-900/10 pt-3">
              <div class="flex flex-wrap items-center gap-2">
                {obra.anio && (
                  <span class="rounded-full bg-[#472d82] px-2 py-0.5 text-[11px] font-bold tabular-nums text-white">
                    {obra.anio}
                  </span>
                )}
                {obra.video && (
                  <span class="inline-flex items-center gap-1 rounded-full border border-[#472d82]/30 px-2 py-0.5 text-[10px] font-bold uppercase tracking-[0.12em] text-[#472d82]">
                    <svg width="10" height="10" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg>
                    Video
                  </span>
                )}
              </div>
              <h4 class="mt-1.5 text-[15px] font-semibold leading-snug tracking-tight text-slate-900">
                {obra.nombre}
              </h4>
              {obra.detalle && (
                <p class="mt-1 text-[13px] leading-relaxed text-slate-500">
                  {obra.detalle}
                </p>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
