---
import './noticias.css';
import NewCard from './NewCard.astro';
import Feed from './SectionNoticias/Feed.tsx';
import { MEDIA } from '@lib/media';

const noticiasData = [
  { id: 1, src: MEDIA.proyectos.playaTurquesa, titulo: 'Playa Turquesa' },
  { id: 2, src: MEDIA.proyectos.lagunaAlalay, titulo: 'Laguna Alalay' },
  { id: 3, src: MEDIA.proyectos.plazaBanderas, titulo: 'Plaza de las Banderas' },
  { id: 4, src: MEDIA.proyectos.parqueVial, titulo: 'Parque Vial' },
  { id: 5, src: MEDIA.temario.salud, titulo: 'Salud Municipal' },
];
---

<section class="noticias-hero">

  <div class="noticias-hero__bg"></div>

  <div class="hero-orb hero-orb--top"></div>

  <div class="hero-orb hero-orb--bottom"></div>

  <div class="noticias-hero__linea"></div>

  <div class="noticias-hero__contenido">
    <div class="noticias-hero__grid">

      <div class="noticias-hero__texto">
        <div class="hero-badge noticias-hero__badge">
          <span class="noticias-hero__badge-dot"></span>
          <span class="noticias-hero__badge-label">Noticias</span>
        </div>

        <h1 class="hero-title noticias-hero__titulo">
          Conoce las<br />
          <span class="noticias-hero__titulo-acento">nuevas noticias</span>
        </h1>

        <p class="hero-subtitle noticias-hero__subtitulo">
          Mantente informado sobre los últimos proyectos, obras entregadas y el avance de nuestra ciudad hacia el futuro.
        </p>

        <div class="hero-cta noticias-hero__cta">
          <a href="#ultimas-noticias" class="noticias-hero__btn">
            <span>Ver últimas noticias</span>
            <svg class="noticias-hero__btn-icono" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
        </div>
      </div>

      <div class="noticias-hero__cards">
        <NewCard noticias={noticiasData} />
      </div>

    </div>
  </div>
</section>

<div class="noticias-feed-bg">
  <Feed client:load />
</div>