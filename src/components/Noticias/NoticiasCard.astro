---
/**
 * NoticiasCard — Card individual de noticia.
 * HTML semántico: <article> + <figure> + <header>.
 * Reutiliza util de fecha y es accesible (link con aria-label).
 */
import { formatFecha } from '@lib/noticias';
import type { Noticia } from '@types/noticias';

interface Props {
  noticia: Noticia;
  eager?: boolean;
}

const { noticia, eager = false } = Astro.props;
const href = `/noticias/${noticia.slug}`;
---

<article
  class="group flex h-full flex-col overflow-hidden rounded-xl border border-white/10 bg-[#1a1a1a] text-white transition-all duration-300 hover:-translate-y-1 hover:border-white/20 hover:shadow-xl hover:shadow-black/20"
>
  <a href={href} class="flex h-full flex-col focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-[#0f0f0f]" aria-label={`Leer noticia: ${noticia.titulo}`}>
    <figure class="relative aspect-[4/3] overflow-hidden bg-neutral-800">
      <img
        src={noticia.imagen}
        alt={noticia.imagenAlt}
        width="640"
        height="480"
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.04]"
      />
      <figcaption class="absolute left-3 top-3">
        <span class="rounded-full bg-black/70 px-2.5 py-1 text-[10px] font-bold uppercase tracking-[0.14em] text-white backdrop-blur">
          {noticia.categoria}
        </span>
      </figcaption>
    </figure>

    <div class="flex flex-1 flex-col p-4">
      <header>
        <time datetime={noticia.fecha} class="text-[11px] font-medium uppercase tracking-[0.14em] text-white/50">
          {formatFecha(noticia.fecha)}
        </time>
        <h3 class="mt-2 line-clamp-2 text-[15px] font-bold leading-snug tracking-tight text-white group-hover:text-accent">
          {noticia.titulo}
        </h3>
      </header>
      <p class="mt-2 line-clamp-2 text-[13px] leading-relaxed text-white/60">
        {noticia.resumen}
      </p>
      <span class="mt-3 inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-[0.12em] text-white/70 group-hover:text-white">
        Leer más
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </span>
    </div>
  </a>
</article>
