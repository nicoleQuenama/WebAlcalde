---
import Card from '@components/ui/Card/Card.astro';
import type { NewCardProps } from '@types/newCard';
import { duplicateForCarousel } from '@lib/array';

const { noticias } = Astro.props as NewCardProps;

const carrete = duplicateForCarousel(noticias);
---

<div class="ticker-wrapper">
  <div class="ticker-track py-4">
    {carrete.map((noticia) => (
      <Card
        src={noticia.src}
        titulo={noticia.titulo}
        class="h-72 w-52 shrink-0"
      />
    ))}
  </div>
</div>
