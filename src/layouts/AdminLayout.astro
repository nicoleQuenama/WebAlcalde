---
import '@styles/global.css';
import type { AdminLayoutProps } from '@types/adminLayout';

const { title } = Astro.props as AdminLayoutProps;
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="robots" content="noindex, nofollow" />
        <title>{title}</title>
    </head>
    <body class="m-0 font-sans">
        <slot />
    </body>
</html>