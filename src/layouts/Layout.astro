---
// src/layouts/Layout.astro
import { ClientRouter } from 'astro:transitions';
import Header from '@components/Header/Header.astro';
import Footer from '@components/global/Footer/Footer.astro';
import Preloader from '@components/Preloader/Preloader.astro';

import '../styles/global.css';

interface Props {
    title: string;
    description?: string;
}
const {title, description = 'Manfred Reyes Villa — Cocha, la mejor ciudad de Bolivia. Obras, gestión y trayectoria.'} = Astro.props;
---
<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
        <meta name="color-scheme" content="light" />
        <meta name="description" content={description} />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <!-- Performance: preconnect críticos -->
        <link rel="preconnect" href="https://fsuxvbuupswucnsvrdce.supabase.co" crossorigin />
        <link rel="dns-prefetch" href="https://fsuxvbuupswucnsvrdce.supabase.co" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <!-- Tipografía no bloqueante: preload + media print trick -->
        <link
            rel="preload"
            as="style"
            href="https://fonts.googleapis.com/css2?family=Roboto+Serif:ital,opsz,wght@0,8..144,400;1,8..144,400&display=swap"
        />
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Roboto+Serif:ital,opsz,wght@0,8..144,400;1,8..144,400&display=swap"
            media="print"
            onload="this.media='all'"
        />
        <link
            rel="preload"
            as="style"
            href="https://fonts.googleapis.com/css2?family=Roboto+Condensed:wght@700&display=swap"
        />
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Roboto+Condensed:wght@700&display=swap"
            media="print"
            onload="this.media='all'"
        />
        <noscript>
            <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto+Serif:ital,opsz,wght@0,8..144,400;1,8..144,400&display=swap" />
            <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto+Condensed:wght@700&display=swap" />
        </noscript>
        <!-- View Transitions SPA: navegación sin reload -->
        <ClientRouter fallback="swap" />
        <style>
            @view-transition { navigation: auto; }
            ::view-transition-old(root),
            ::view-transition-new(root) { animation-duration: 0.22s; animation-timing-function: ease; }
            ::view-transition-old(root) { animation-name: vt-fade-out; }
            ::view-transition-new(root) { animation-name: vt-fade-in; }
            @keyframes vt-fade-out { from{opacity:1} to{opacity:0} }
            @keyframes vt-fade-in { from{opacity:0} to{opacity:1} }
            html { view-transition-name: root; scrollbar-gutter: stable; }
        </style>
        <style>
            /* El libro abierto ocupa toda la pantalla: el header y el footer
               se ocultan mientras dure la vista (overlay abierto). La clase
               `flipbook-open` la agrega FlipBook en el body. */
            body.flipbook-open [data-astro-transition-persist='header'],
            body.flipbook-open :global(footer) {
                visibility: hidden;
                opacity: 0;
                transition: opacity 0.3s ease, visibility 0.3s ease;
            }
        </style>
    </head>
    <body class="m-0 font-sans bg-gray-50 antialiased">
        <Preloader />
        <div transition:persist="header">
            <Header/>
        </div>
        
        <main transition:animate="fade">
            <slot/>
        </main>

        <Footer />
        <script>
            document.addEventListener('astro:page-load', () => {
                const links = document.querySelectorAll('a[href^="/"]:not([data-astro-reload])');
                links.forEach((a) => {
                    // @ts-ignore
                    if (a.dataset.prefetchBound) return;
                    // @ts-ignore
                    a.dataset.prefetchBound = '1';
                    const doPrefetch = () => {
                        const href = a.getAttribute('href');
                        if (!href) return;
                        try {
                            const url = new URL(href, location.origin);
                            if (url.origin !== location.origin) return;
                            // @ts-ignore
                            if (window.__astro_prefetch) window.__astro_prefetch(href);
                        } catch {}
                    };
                    a.addEventListener('mouseenter', doPrefetch, { once: true });
                    a.addEventListener('touchstart', doPrefetch, { once: true, passive: true });
                    a.addEventListener('focus', doPrefetch, { once: true });
                });
                if (!location.hash) window.scrollTo(0, 0);
            });
        </script>

        <!--
            Modo "vista previa del CMS": esta página se sirve tal cual siempre,
            pero cuando alguien la abre DENTRO del iframe del editor
            (`/admin/[secret]`), este script activa clicks para seleccionar la
            sección/tarjeta editable en vez de navegar — igual que Wix/Squarespace.
            Se activa solo si `window.top !== window.self` (embebida).
        -->
        <script>
            // Guarda contra doble registro: con View Transitions este script
            // vuelve a ejecutarse en cada navegación interna (igual que el
            // bloque de prefetch de arriba), pero `document` sobrevive el
            // morph — así que el listener de clicks debe registrarse UNA sola vez.
            if (window.top !== window.self && !(window as any).__cmsPreviewBound) {
                (window as any).__cmsPreviewBound = true;
                const estilo = document.createElement('style');
                estilo.textContent = `
                    [data-cms-dominio] { cursor: pointer; position: relative; }
                    [data-cms-dominio]:hover { outline: 2px dashed #472d82; outline-offset: -2px; }
                    [data-cms-clave] { position: relative; }
                    [data-cms-clave]:hover { outline: 2px solid #472d82; outline-offset: -2px; }
                    .cms-seleccionado { outline: 2px solid #472d82 !important; outline-offset: -2px; }
                    [data-cms-campo] { cursor: text; border-radius: 3px; }
                    [data-cms-campo]:hover { background: rgba(71, 45, 130, 0.08); outline: 2px dashed #472d82; outline-offset: 2px; }
                    [data-cms-campo][contenteditable="true"] { background: rgba(71, 45, 130, 0.08); outline: 2px solid #472d82 !important; outline-offset: 2px; cursor: text; }
                    .cms-dragging-preview { opacity: 0.35 !important; }
                    .cms-drag-over-preview { outline: 3px solid #c9b8e8 !important; outline-offset: -2px; }
                    .cms-drop-indicator { height: 4px; background: #472d82; border-radius: 999px; margin: 4px 0; transition: height 0.12s; }
                    .cms-preview-toolbar { position: absolute; top: 6px; right: 6px; display: flex; gap: 4px; z-index: 9999; opacity: 0; pointer-events: none; transition: opacity 0.15s; }
                    [data-cms-dominio]:hover > .cms-preview-toolbar, [data-cms-clave]:hover > .cms-preview-toolbar, .cms-preview-toolbar:hover { opacity: 1; pointer-events: auto; }
                    .cms-preview-toolbar button { appearance:none; border: none; background: #472d82; color: #fff; font-size: 11px; font-weight: 700; padding: 4px 7px; border-radius: 999px; cursor: pointer; box-shadow: 0 2px 8px rgba(0,0,0,0.18); }
                    .cms-preview-toolbar button:hover { background: #2a1a49; }
                    .cms-preview-toolbar button.cms-handle { cursor: grab; background: #fff; color: #472d82; border: 1px solid #c9b8e8; }
                    .cms-preview-toolbar button.cms-handle:active { cursor: grabbing; }
                    .cms-pegado-flash { animation: cmsFlash 0.6s ease; }
                    @keyframes cmsFlash { 0%{ outline: 3px solid #c9b8e8; } 100%{ outline: 2px dashed #472d82; } }
                `;
                document.head.appendChild(estilo);

                let seleccionado: HTMLElement | null = null;

                function avisarPagina() {
                    window.parent.postMessage({ source: 'cms-preview', type: 'pagina', ruta: location.pathname }, '*');
                }
                document.addEventListener('astro:page-load', avisarPagina);
                avisarPagina();

                // ── Mapeo dominio → key layout ──
                const DOMINIO_A_KEY: Record<string,string> = {
                    'home_hero':'hero','home_biografia':'biografia','home_antes_despues':'antes_despues','flipbook_meta':'libro',
                    'gestion_hero':'hero','capitulo':'capitulos','era':'eras','seccion':'secciones','proyectos_titulo':'proyectos_titulo','proyecto':'proyectos',
                    'sobre_hero':'hero','sobre_biografia':'biografia','sobre_institutional':'institutional',
                };

                // Clipboard recibido del editor para mostrar botón Pegar en preview
                let clipboardPreview: { dominio:string; label:string } | null = null;
                window.addEventListener('message', (e)=>{
                    const d = e.data as any;
                    if(d?.source==='cms-editor' && d.type==='clipboard'){ clipboardPreview = d.payload; refrescarToolbars(); }
                    if(d?.source==='cms-editor' && d.type==='cms-sync'){
                        // Sincronización viva desde editor: reordenar DOM sin reload
                        try{
                            if(d.ordenLayout && Array.isArray(d.ordenLayout)){
                                const flexContainers = Array.from(document.querySelectorAll<HTMLElement>('div[style*="flex-direction:column"], main[style*="display:flex"]'));
                                flexContainers.forEach(container=>{
                                    const hijos = Array.from(container.children).filter(el=> el instanceof HTMLElement && (el as HTMLElement).hasAttribute('data-cms-dominio')) as HTMLElement[];
                                    if(hijos.length<2) return;
                                    const porDominio = new Map(hijos.map(h=> [DOMINIO_A_KEY[h.dataset.cmsDominio||''] || h.dataset.cmsDominio, h] as const));
                                    d.ordenLayout.forEach((key:string, idx:number)=>{
                                        const el = porDominio.get(key);
                                        if(el){ (el as HTMLElement).style.order = String(idx); }
                                    });
                                });
                            }
                            if(d.ordenClaves && d.dominio){
                                const all = Array.from(document.querySelectorAll<HTMLElement>(`[data-cms-dominio="${d.dominio}"][data-cms-clave], [data-cms-clave]`)).filter(el=> (el.getAttribute('data-cms-dominio')||'')===d.dominio);
                                // Reorden por parent
                                const porParent = new Map<HTMLElement, HTMLElement[]>();
                                all.forEach(el=>{ const p = el.parentElement!; if(!porParent.has(p)) porParent.set(p, []); porParent.get(p)!.push(el); });
                                porParent.forEach((items, parent)=>{
                                    const mapa = new Map(items.map(i=> [i.dataset.cmsClave!, i]));
                                    d.ordenClaves.forEach((k:string)=>{
                                        const node = mapa.get(k);
                                        if(node) parent.appendChild(node);
                                    });
                                });
                            }
                        }catch{}
                    }
                });

                function crearToolbar(el: HTMLElement, opts:{ dominio:string; clave?:string; esSeccion:boolean }){
                    if(el.querySelector(':scope > .cms-preview-toolbar')) return;
                    const tb = document.createElement('div');
                    tb.className = 'cms-preview-toolbar';
                    const handle = document.createElement('button');
                    handle.className = 'cms-handle'; handle.textContent = '⋮⋮'; handle.title='Arrastrar';
                    handle.draggable = true;
                    // handle inicia drag del padre
                    handle.addEventListener('dragstart', (e)=>{
                        el.classList.add('cms-dragging-preview');
                        e.dataTransfer!.effectAllowed='move';
                        e.dataTransfer!.setData('text/plain', opts.clave || opts.dominio);
                        (window as any).__cmsDragSrc = el;
                        (window as any).__cmsDragInfo = opts;
                        e.stopPropagation();
                    });
                    handle.addEventListener('dragend', ()=>{ el.classList.remove('cms-dragging-preview'); (window as any).__cmsDragSrc=null; });
                    tb.append(handle);
                    const up = document.createElement('button'); up.textContent='↑'; up.title='Subir';
                    up.addEventListener('click',(e)=>{ e.preventDefault(); e.stopPropagation(); window.parent.postMessage({ source:'cms-preview', type:'reordenar', dominio: opts.dominio, clave: opts.clave, direccion:'up' }, '*'); moverVisual(el,'up'); });
                    const down = document.createElement('button'); down.textContent='↓'; down.title='Bajar';
                    down.addEventListener('click',(e)=>{ e.preventDefault(); e.stopPropagation(); window.parent.postMessage({ source:'cms-preview', type:'reordenar', dominio: opts.dominio, clave: opts.clave, direccion:'down' }, '*'); moverVisual(el,'down'); });
                    tb.append(up, down);
                    const copiar = document.createElement('button'); copiar.textContent='⧉'; copiar.title='Copiar';
                    copiar.addEventListener('click',(e)=>{ e.preventDefault(); e.stopPropagation(); window.parent.postMessage({ source:'cms-preview', type:'copiar', dominio: opts.dominio, clave: opts.clave }, '*'); });
                    tb.append(copiar);
                    const pegar = document.createElement('button'); pegar.textContent='📋'; pegar.title='Pegar aquí';
                    pegar.className='cms-pegar-btn';
                    pegar.hidden = !(clipboardPreview && clipboardPreview.dominio===opts.dominio);
                    pegar.addEventListener('click',(e)=>{ e.preventDefault(); e.stopPropagation(); window.parent.postMessage({ source:'cms-preview', type:'pegar', dominio: opts.dominio, clave: opts.clave, posicion:'despues' }, '*'); });
                    tb.append(pegar);
                    const editar = document.createElement('button'); editar.textContent='✎'; editar.title='Editar';
                    editar.addEventListener('click',(e)=>{ e.preventDefault(); e.stopPropagation(); window.parent.postMessage({ source:'cms-preview', type:'seleccionar', dominio: opts.dominio, clave: opts.clave }, '*'); });
                    tb.append(editar);
                    el.append(tb);
                }

                function moverVisual(el: HTMLElement, dir:'up'|'down'){
                    // Mueve DOM para feedback inmediato antes de que editor confirme
                    if(el.hasAttribute('data-cms-clave')){
                        const p = el.parentElement; if(!p) return;
                        if(dir==='up' && el.previousElementSibling) p.insertBefore(el, el.previousElementSibling);
                        if(dir==='down' && el.nextElementSibling) p.insertBefore(el.nextElementSibling, el);
                    } else if(el.hasAttribute('data-cms-dominio')){
                        // sección layout: actualizar order visual
                        const container = el.parentElement as HTMLElement | null; if(!container) return;
                        const hijos = Array.from(container.children).filter(c=> c instanceof HTMLElement && (c as HTMLElement).hasAttribute('data-cms-dominio')) as HTMLElement[];
                        const idx = hijos.indexOf(el);
                        const ni = dir==='up' ? idx-1 : idx+1; if(ni<0||ni>=hijos.length) return;
                        const target = hijos[ni];
                        if(dir==='up') container.insertBefore(el, target); else container.insertBefore(el, target.nextSibling);
                        // Actualizar style.order para que flex refleje cambio
                        Array.from(container.children).filter(c=> c instanceof HTMLElement && (c as HTMLElement).hasAttribute('data-cms-dominio')).forEach((c,i)=> (c as HTMLElement).style.order=String(i));
                        const nuevoOrdenDominios = Array.from(container.children).filter(c=> c instanceof HTMLElement && (c as HTMLElement).hasAttribute('data-cms-dominio')).map(c=> (c as HTMLElement).dataset.cmsDominio!);
                        const nuevoOrdenKeys = nuevoOrdenDominios.map(d=> DOMINIO_A_KEY[d] || d);
                        window.parent.postMessage({ source:'cms-preview', type:'reordenar', orden:nuevoOrdenKeys }, '*');
                    }
                    el.classList.add('cms-pegado-flash'); setTimeout(()=> el.classList.remove('cms-pegado-flash'), 700);
                }

                function refrescarToolbars(){
                    document.querySelectorAll<HTMLElement>('.cms-pegar-btn').forEach(b=>{
                        const host = b.closest('[data-cms-dominio], [data-cms-clave]') as HTMLElement | null;
                        if(!host) return;
                        const dom = host.getAttribute('data-cms-dominio') || host.dataset.cmsDominio || '';
                        b.hidden = !(clipboardPreview && clipboardPreview.dominio===dom);
                    });
                }

                // Auto-scroll durante drag
                let autoScrollDir = 0; let autoScrollRaf = 0;
                function loopAutoScroll(){
                    if(autoScrollDir!==0) window.scrollBy(0, autoScrollDir*14);
                    autoScrollRaf = requestAnimationFrame(loopAutoScroll);
                }
                loopAutoScroll();
                document.addEventListener('dragover', (e)=>{
                    const y = (e as DragEvent).clientY;
                    if(y < 90) autoScrollDir = -1; else if(y > window.innerHeight - 90) autoScrollDir = 1; else autoScrollDir = 0;
                });
                document.addEventListener('dragend', ()=> autoScrollDir=0);
                document.addEventListener('drop', ()=> autoScrollDir=0);

                function habilitarDragPreview(){
                    // Secciones layout (hijos directos de flex column)
                    const flexContainers = Array.from(document.querySelectorAll<HTMLElement>('div[style*="flex-direction:column"], main[style*="display:flex"]'));
                    flexContainers.forEach(container=>{
                        const hijos = Array.from(container.children).filter(el=> el instanceof HTMLElement && (el as HTMLElement).hasAttribute('data-cms-dominio')) as HTMLElement[];
                        if(hijos.length<2) return;
                        hijos.forEach(h=>{
                            crearToolbar(h, { dominio: h.dataset.cmsDominio||'', esSeccion:true });
                            if(h.dataset.cmsDragBound) return;
                            h.dataset.cmsDragBound='1';
                            // Hacer drop target para handle drag
                            h.addEventListener('dragover',(e)=>{ e.preventDefault(); h.classList.add('cms-drag-over-preview'); });
                            h.addEventListener('dragleave',()=> h.classList.remove('cms-drag-over-preview'));
                            h.addEventListener('drop',(e)=>{
                                e.preventDefault(); h.classList.remove('cms-drag-over-preview');
                                const src = (window as any).__cmsDragSrc as HTMLElement|null;
                                const info = (window as any).__cmsDragInfo as any;
                                if(!src || src===h || src.parentElement!==container) return;
                                // Si es item (clave), ignorar aquí
                                if(info?.clave) return;
                                const order = Array.from(container.children).filter(c=> c instanceof HTMLElement && (c as HTMLElement).hasAttribute('data-cms-dominio')) as HTMLElement[];
                                const fromIdx = order.indexOf(src); const toIdx = order.indexOf(h);
                                if(fromIdx===-1||toIdx===-1) return;
                                if(fromIdx<toIdx) container.insertBefore(src, h.nextSibling); else container.insertBefore(src, h);
                                // Actualizar order styles para feedback
                                Array.from(container.children).filter(c=> c instanceof HTMLElement && (c as HTMLElement).hasAttribute('data-cms-dominio')).forEach((c,i)=> (c as HTMLElement).style.order=String(i));
                                const nuevoOrdenDominios = Array.from(container.children).filter(c=> c instanceof HTMLElement && (c as HTMLElement).hasAttribute('data-cms-dominio')).map(c=> (c as HTMLElement).dataset.cmsDominio!);
                                const nuevoOrdenKeys = nuevoOrdenDominios.map(d=> DOMINIO_A_KEY[d] || d);
                                window.parent.postMessage({ source:'cms-preview', type:'reordenar', orden:nuevoOrdenKeys }, '*');
                            });
                        });
                    });
                    // Items con clave
                    document.querySelectorAll<HTMLElement>('[data-cms-clave]').forEach(item=>{
                        const dominio = item.getAttribute('data-cms-dominio') || '';
                        crearToolbar(item, { dominio, clave: item.dataset.cmsClave, esSeccion:false });
                        if(item.dataset.cmsItemDragBound) return;
                        item.dataset.cmsItemDragBound='1';
                        item.addEventListener('dragover',(e)=>{ e.preventDefault(); e.stopPropagation(); item.classList.add('cms-drag-over-preview'); });
                        item.addEventListener('dragleave',()=> item.classList.remove('cms-drag-over-preview'));
                        item.addEventListener('drop',(e)=>{
                            e.preventDefault(); e.stopPropagation(); item.classList.remove('cms-drag-over-preview');
                            const src = (window as any).__cmsDragSrc as HTMLElement|null;
                            const info = (window as any).__cmsDragInfo as any;
                            if(!src || src===item) return;
                            const domSrc = info?.dominio || src.getAttribute('data-cms-dominio') || '';
                            const domDst = dominio;
                            if(domSrc!==domDst) return;
                            const parent = item.parentElement; if(!parent || src.parentElement!==parent) return;
                            const siblings = Array.from(parent.children).filter(c=> c instanceof HTMLElement && (c as HTMLElement).hasAttribute('data-cms-clave')) as HTMLElement[];
                            const fromIdx = siblings.indexOf(src); const toIdx = siblings.indexOf(item);
                            if(fromIdx===-1||toIdx===-1) return;
                            if(fromIdx<toIdx) parent.insertBefore(src, item.nextSibling); else parent.insertBefore(src, item);
                            const nuevoOrden = Array.from(parent.children).filter(c=> c instanceof HTMLElement && (c as HTMLElement).hasAttribute('data-cms-clave')).map(c=> (c as HTMLElement).dataset.cmsClave!);
                            const dir = fromIdx<toIdx ? 'down' : 'up';
                            window.parent.postMessage({ source:'cms-preview', type:'reordenar', dominio: domSrc, clave: src.dataset.cmsClave, direccion: dir, ordenClaves: nuevoOrden }, '*');
                        });
                    });
                }

                // Inicializar
                habilitarDragPreview();
                document.addEventListener('astro:page-load', ()=> setTimeout(habilitarDragPreview, 80));
                setTimeout(habilitarDragPreview, 600);
                const obsPreview = new MutationObserver(()=> habilitarDragPreview());
                obsPreview.observe(document.body, { childList:true, subtree:true });

                // ── Picker de imagen/video al presionar foto ─────────────────────
                function crearPickerOverlay(){
                    if(document.getElementById('cms-img-picker')) return document.getElementById('cms-img-picker') as HTMLElement;
                    const overlay = document.createElement('div');
                    overlay.id = 'cms-img-picker';
                    overlay.style.cssText = 'position:fixed; inset:0; z-index:10000; background:rgba(36,26,58,0.55); display:none; align-items:center; justify-content:center; padding:16px;';
                    overlay.innerHTML = `
                        <div style="background:#fff; border-radius:16px; max-width:520px; width:100%; padding:18px; box-shadow:0 20px 60px rgba(0,0,0,0.35); display:flex; flex-direction:column; gap:12px;">
                            <div style="display:flex; justify-content:space-between; align-items:center;">
                                <strong style="font-size:14px; color:#241a3a;">Cambiar imagen / video</strong>
                                <button type="button" id="cms-picker-cerrar" style="border:none; background:#f3efff; color:#472d82; width:28px; height:28px; border-radius:999px; cursor:pointer;">✕</button>
                            </div>
                            <img id="cms-picker-preview" style="width:100%; max-height:220px; object-fit:contain; border-radius:10px; border:1px solid #e3dbf5; display:none;" />
                            <video id="cms-picker-video" style="width:100%; max-height:220px; border-radius:10px; display:none;" controls></video>
                            <label style="font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; color:#6b5f87;">URL de la imagen / video</label>
                            <input id="cms-picker-url" type="url" placeholder="https://..." style="font:inherit; font-size:13px; padding:10px 12px; border:1px solid #e3dbf5; border-radius:8px; width:100%; box-sizing:border-box;" />
                            <label style="font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; color:#6b5f87;">O subir archivo</label>
                            <input id="cms-picker-file" type="file" accept="image/*,video/*" style="font-size:12px;" />
                            <div style="display:flex; gap:8px; justify-content:flex-end; margin-top:4px;">
                                <button type="button" id="cms-picker-cancel" style="appearance:none; border:1px solid #e3dbf5; background:#fff; color:#6b5f87; font-weight:700; font-size:13px; padding:8px 14px; border-radius:999px; cursor:pointer;">Cancelar</button>
                                <button type="button" id="cms-picker-apply" style="appearance:none; border:none; background:#472d82; color:#fff; font-weight:700; font-size:13px; padding:8px 16px; border-radius:999px; cursor:pointer;">Aplicar</button>
                            </div>
                            <p style="font-size:11px; color:#6b5f87; margin:0;">Pega una URL o sube un archivo. El cambio se ve al instante y se guarda con "Guardar cambios".</p>
                        </div>
                    `;
                    document.body.appendChild(overlay);
                    overlay.addEventListener('click', (e)=>{ if(e.target===overlay) overlay.style.display='none'; });
                    overlay.querySelector('#cms-picker-cerrar')!.addEventListener('click', ()=> overlay.style.display='none');
                    overlay.querySelector('#cms-picker-cancel')!.addEventListener('click', ()=> overlay.style.display='none');
                    return overlay;
                }
                let pickerCtx: { imgEl?: HTMLImageElement; videoEl?: HTMLVideoElement; dominio?: string; clave?: string; campo?: string; originalSrc: string } | null = null;
                function abrirPicker(imgEl: HTMLImageElement | null, videoEl: HTMLVideoElement | null, dominio: string | undefined, clave: string | undefined){
                    const overlay = crearPickerOverlay();
                    const urlInput = overlay.querySelector('#cms-picker-url') as HTMLInputElement;
                    const fileInput = overlay.querySelector('#cms-picker-file') as HTMLInputElement;
                    const previewImg = overlay.querySelector('#cms-picker-preview') as HTMLImageElement;
                    const previewVideo = overlay.querySelector('#cms-picker-video') as HTMLVideoElement;
                    const originalSrc = imgEl?.currentSrc || imgEl?.src || videoEl?.currentSrc || videoEl?.src || (imgEl?.parentElement?.querySelector('[data-url]') as HTMLElement)?.dataset.url || '';
                    pickerCtx = { imgEl: imgEl||undefined, videoEl: videoEl||undefined, dominio, clave, campo: dominio ? 'imagen' : undefined, originalSrc };
                    urlInput.value = originalSrc;
                    fileInput.value = '';
                    if(videoEl || originalSrc.match(/\.(mp4|webm|mov)(\?|$)/i)){
                        previewImg.style.display='none';
                        previewVideo.style.display='block';
                        previewVideo.src = originalSrc;
                    } else {
                        previewVideo.style.display='none';
                        previewImg.style.display='block';
                        previewImg.src = originalSrc;
                    }
                    overlay.style.display='flex';
                    urlInput.oninput = ()=>{
                        const v = urlInput.value.trim();
                        if(v.match(/\.(mp4|webm|mov)(\?|$)/i) || v.includes('video')){
                            previewImg.style.display='none'; previewVideo.style.display='block'; previewVideo.src=v;
                        } else if(v){
                            previewVideo.style.display='none'; previewImg.style.display='block'; previewImg.src=v;
                        }
                    };
                    fileInput.onchange = ()=>{
                        const file = fileInput.files?.[0];
                        if(!file) return;
                        const reader = new FileReader();
                        reader.onload = ()=>{
                            const dataUrl = String(reader.result||'');
                            urlInput.value = dataUrl;
                            if(file.type.startsWith('video')){
                                previewImg.style.display='none'; previewVideo.style.display='block'; previewVideo.src=dataUrl;
                            } else {
                                previewVideo.style.display='none'; previewImg.style.display='block'; previewImg.src=dataUrl;
                            }
                        };
                        reader.readAsDataURL(file);
                    };
                    const applyBtn = overlay.querySelector('#cms-picker-apply') as HTMLButtonElement;
                    applyBtn.onclick = ()=>{
                        const nuevo = urlInput.value.trim();
                        if(!nuevo) return;
                        // Actualizar preview al instante
                        if(pickerCtx?.imgEl) pickerCtx.imgEl.src = nuevo;
                        if(pickerCtx?.videoEl) pickerCtx.videoEl.src = nuevo;
                        // También actualizar data-url / background si existe
                        const dataEl = (pickerCtx?.imgEl?.closest('[data-url]') as HTMLElement) || (pickerCtx?.imgEl?.parentElement?.querySelector('[data-url]') as HTMLElement);
                        if(dataEl) dataEl.dataset.url = nuevo;
                        // Si la imagen está dentro de un bloque CMS con campo imagen, notificar campo
                        if(dominio){
                            const campoNombre = (clave ? 'imagen' : 'imagen') as string;
                            // Detectar si es video por extensión
                            const esVideo = nuevo.match(/\.(mp4|webm|mov)/i) || (pickerCtx?.videoEl ? true : false);
                            const campoFinal = esVideo ? 'video' : campoNombre;
                            window.parent.postMessage({ source:'cms-preview', type:'campo', dominio, clave, campo: campoFinal, valor: nuevo }, '*');
                            // También mandar tipo específico para que editor actualice y haga live sync
                            window.parent.postMessage({ source:'cms-preview', type:'imagen', dominio, clave, src: nuevo, originalSrc }, '*');
                        } else {
                            // Imagen genérica sin dominio: override global
                            window.parent.postMessage({ source:'cms-preview', type:'imagen', src: nuevo, originalSrc }, '*');
                            // Aplicar a todas las imgs con mismo src original
                            document.querySelectorAll<HTMLImageElement>('img').forEach(im=>{ if(im.src===originalSrc || im.currentSrc===originalSrc) im.src=nuevo; });
                        }
                        overlay.style.display='none';
                    };
                }

                function terminarEdicion(campoEl: HTMLElement, dominio: string, clave: string | undefined) {
                    campoEl.contentEditable = 'false';
                    window.parent.postMessage(
                        {
                            source: 'cms-preview',
                            type: 'campo',
                            dominio,
                            clave,
                            campo: campoEl.dataset.cmsCampo,
                            valor: campoEl.innerText.trim(),
                        },
                        '*',
                    );
                }

                document.addEventListener(
                    'click',
                    (e) => {
                        const target = e.target as HTMLElement;
                        if(target.closest('.cms-preview-toolbar') || target.closest('#cms-img-picker')) return;
                        // ── Click directo en foto/video: abrir picker de imagen ──
                        const imgDirect = target.closest('img') as HTMLImageElement | null;
                        const videoDirect = target.closest('video') as HTMLVideoElement | null;
                        const expandEl = target.closest('[data-expand]') as HTMLElement | null;
                        if(imgDirect || videoDirect || expandEl){
                            const imgForPicker = imgDirect || (expandEl?.querySelector('img') as HTMLImageElement | null) || null;
                            const videoForPicker = videoDirect || null;
                            // Si es dentro de un bloque CMS, intentar usar su dominio/clave
                            const conClaveImg = (imgDirect ?? expandEl ?? videoDirect)?.closest('[data-cms-clave]') as HTMLElement | null;
                            const conDominioImg = (conClaveImg ?? (imgDirect ?? expandEl ?? videoDirect)?.closest('[data-cms-dominio]')) as HTMLElement | null;
                            // También detectar Hero background o sección con imagen: siempre permitir picker
                            const dominioImg = conDominioImg?.dataset.cmsDominio;
                            const claveImg = conClaveImg?.dataset.cmsClave;
                            // Evitar que el click en imagen dispare edición de texto si es que la imagen está dentro de conCampo
                            // Abrir picker y detener propagación
                            e.preventDefault(); e.stopPropagation();
                            abrirPicker(imgForPicker, videoForPicker, dominioImg, claveImg);
                            return;
                        }
                        const conCampo = target.closest('[data-cms-campo]') as HTMLElement | null;
                        const conClave = target.closest('[data-cms-clave]') as HTMLElement | null;
                        const conDominio = (conClave ?? target.closest('[data-cms-dominio]')) as HTMLElement | null;
                        if (!conDominio) return;
                        e.preventDefault();
                        e.stopPropagation();

                        seleccionado?.classList.remove('cms-seleccionado');
                        seleccionado = conClave ?? conDominio;
                        seleccionado.classList.add('cms-seleccionado');

                        // Texto simple (título, párrafo, etc.): editable ahí mismo, sin modal.
                        if (conCampo) {
                            if (conCampo.isContentEditable) return; // ya se está editando
                            conCampo.contentEditable = 'true';
                            conCampo.focus();
                            const rango = document.createRange();
                            rango.selectNodeContents(conCampo);
                            const seleccion = window.getSelection();
                            seleccion?.removeAllRanges();
                            seleccion?.addRange(rango);

                            const dominio = conDominio.dataset.cmsDominio!;
                            const clave = conClave?.dataset.cmsClave;
                            const alPerderFoco = () => {
                                terminarEdicion(conCampo, dominio, clave);
                                conCampo.removeEventListener('blur', alPerderFoco);
                                conCampo.removeEventListener('keydown', alTeclear);
                            };
                            const alTeclear = (ke: KeyboardEvent) => {
                                if (ke.key === 'Enter' && !conCampo.hasAttribute('data-cms-multilinea')) {
                                    ke.preventDefault();
                                    conCampo.blur();
                                }
                                if (ke.key === 'Escape') conCampo.blur();
                            };
                            conCampo.addEventListener('blur', alPerderFoco);
                            conCampo.addEventListener('keydown', alTeclear);
                            return;
                        }

                        // Cualquier otra cosa (imagen, selector, obras, o la sección en general): abre el modal.
                        window.parent.postMessage(
                            {
                                source: 'cms-preview',
                                type: 'seleccionar',
                                dominio: conDominio.dataset.cmsDominio,
                                clave: conClave?.dataset.cmsClave,
                            },
                            '*',
                        );
                    },
                    true,
                );
            }
        </script>
    </body>
</html>
