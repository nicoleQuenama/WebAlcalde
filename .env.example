# Copiá este archivo a .env y completá los valores.
# El .env NO se commitea (está en .gitignore) y NO se hornea en la imagen:
# el servidor Node lo lee en runtime (docker compose lo inyecta via env_file).

# --- Servidor Node (adapter standalone) ---
HOST=0.0.0.0
PORT=4321

# --- Supabase / Postgres (para el fetch de contenido en runtime) ---
# En el panel de Supabase: Project Settings → API
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=

# Solo si el fetch se hace server-side y necesita saltear RLS.
# NUNCA con prefijo PUBLIC_ ni expuesta al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Alternativa: conexión directa a Postgres (Project Settings → Database)
# DATABASE_URL=postgresql://postgres:[password]@db.xxxx.supabase.co:5432/postgres
