# Copiá este archivo a .env y completá los valores.
# El .env NO se commitea (está en .gitignore) y NO se hornea en la imagen:
# el servidor Node lo lee en runtime (docker compose lo inyecta via env_file).

# --- Servidor Node (adapter standalone) ---
HOST=0.0.0.0
PORT=4321

# --- Postgres (OBLIGATORIO) ---
# La capa de contenido (src/lib/db.ts) usa esta conexión. Sin ella el
# servidor NO arranca. Uso local:
#   DATABASE_URL=postgresql://postgres:clave@localhost:5432/webalcalde
DATABASE_URL= postgresql://postgres:Tobanni56@localhost:5432/webalcalde

# --- docker compose: credenciales del contenedor Postgres ---
# Solo se usan si levantás el stack con `docker compose up` (servicio `db`).
# El `web` del compose arma la DATABASE_URL apuntando a ese contenedor.
POSTGRES_USER=alcalde
POSTGRES_PASSWORD=alcalde
POSTGRES_DB=webalcalde

# --- CMS (beta) ---
# Segmento secreto de la ruta del editor: /admin/<este-valor>. Generá algo
# largo y al azar (ej. `openssl rand -hex 16`). Sin este valor, /admin/* da 404.
# También protege la API del editor (header X-Admin-Secret).
ADMIN_SECRET_PATH=

# --- Autenticación del panel (crea la cuenta en el primer acceso) ---
# El formulario de /admin/login valida contra (usuario, hash bcrypt) guardado
# en la tabla `usuario` de la DB. La contraseña NUNCA se guarda en claro: al
# primer acceso se genera el hash (cost 12) si la cuenta no existe.
ADMIN_USER=admin
ADMIN_PASSWORD=
# En producción (HTTPS) poné COOKIE_SECURE=true para que la cookie de sesión
# solo viaje por https. En local HTTP déjalo en false.
COOKIE_SECURE=false